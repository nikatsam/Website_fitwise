---
import PageFamilyLayout from './PageFamilyLayout.astro';
import FitServicesStudio from '../fitcheck/FitServicesStudio.astro';
import RugFitCheck from '../fitcheck/RugFitCheck.astro';
import WorkspaceFitCheck from '../fitcheck/WorkspaceFitCheck.astro';
import BedroomFitCheck from '../fitcheck/BedroomFitCheck.astro';
import DiningFitCheck from '../fitcheck/DiningFitCheck.astro';
import UniversalFitCheck from '../fitcheck/UniversalFitCheck.astro';
import { CORE_CALCULATOR_START_GUIDANCE } from '../../lib/fit/start-guidance';
import type { BreadcrumbItem, ContentNavigationLink } from '../../lib/content';
import type { FeaturePageRecord } from '../../data/feature-pages';
import type { PageIntent, SeoPublication, SourceRecord } from '../../types';
import { ES_FEATURE_COPY } from '../../i18n/es-features';
import { englishPathname, localeFromPath, pathForLocale } from '../../i18n/locale';
import { translateRequired } from '../../i18n/text';

interface Props {
  pageIntent: PageIntent;
  publication: SeoPublication;
  feature: FeaturePageRecord;
  breadcrumb: BreadcrumbItem[];
  links: ContentNavigationLink[];
  sources: SourceRecord[];
}

const { pageIntent, publication, feature, breadcrumb, links, sources } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const localizedCopy = locale === 'es' ? ES_FEATURE_COPY[pageIntent.id] : undefined;
if (locale === 'es' && !localizedCopy) {
  throw new Error(`Missing Spanish feature content for '${pageIntent.id}'.`);
}
const intro = localizedCopy?.intro ?? feature.intro;
const calculation = localizedCopy?.calculation ?? feature.calculation;
const limitations = localizedCopy?.limitations ?? feature.limitations;
const isIndexDirectory = ['pi-feature-fit-checks-directory', 'pi-feature-garden-hub'].includes(
  pageIntent.id,
);
const isAdvancedStudio = pageIntent.id === 'pi-feature-fit-services-hub';
const DirectTool = {
  'pi-feature-workspace-hub': WorkspaceFitCheck,
  'pi-feature-bedroom': BedroomFitCheck,
  'pi-feature-dining': DiningFitCheck,
  'pi-feature-will-it-fit': UniversalFitCheck,
}[pageIntent.id];
const hasCalculator = Boolean(
  feature.toolRenderer === 'rug-fit' ||
  (feature.mode && feature.modeCategory) ||
  DirectTool ||
  isAdvancedStudio,
);
const startGuidance =
  feature.toolRenderer === 'rug-fit'
    ? CORE_CALCULATOR_START_GUIDANCE.rug
    : pageIntent.id === 'pi-feature-workspace-hub'
      ? CORE_CALCULATOR_START_GUIDANCE.workspace
      : pageIntent.id === 'pi-feature-bedroom'
        ? CORE_CALCULATOR_START_GUIDANCE.bedroom
        : pageIntent.id === 'pi-feature-dining'
          ? CORE_CALCULATOR_START_GUIDANCE.dining
          : pageIntent.id === 'pi-feature-will-it-fit'
            ? CORE_CALCULATOR_START_GUIDANCE.universal
            : undefined;
const relatedLinks = links.map((link) => ({
  ...link,
  description:
    localizedCopy?.relatedReasons?.[englishPathname(link.href)] ??
    (locale === 'en' ? feature.relatedReasons?.[englishPathname(link.href)] : undefined) ??
    link.description,
}));
---

<PageFamilyLayout breadcrumb={breadcrumb} h1={publication.h1} beforeStart={startGuidance}>
  <p slot="purpose" class="feature-intro">
    {intro}
  </p>
  {feature.kind === 'hub' || isIndexDirectory ? (
    <section aria-labelledby="feature-areas">
      <h2 id="feature-areas">{translateRequired(locale, 'Fit services')}</h2>
      <ul class="feature-links">
        {relatedLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
            <p>{link.description}</p>
          </li>
        ))}
      </ul>
      <p>{calculation}</p>
    </section>
  ) : hasCalculator ? (
    <>
      <section aria-labelledby="feature-how-it-works">
        <h2 id="feature-how-it-works">{translateRequired(locale, 'How this check works')}</h2>
        <p>{calculation}</p>
      </section>
      <div data-shell-section="calculator">
        {feature.toolRenderer === 'rug-fit' ? (
          <RugFitCheck />
        ) : DirectTool ? (
          <DirectTool />
        ) : isAdvancedStudio ? (
          <FitServicesStudio />
        ) : feature.mode && feature.modeCategory ? (
          <FitServicesStudio
            category={feature.modeCategory}
            initialMode={feature.mode}
            pinnedMode
          />
        ) : null}
      </div>
      <section aria-labelledby="feature-limitations">
        <h2 id="feature-limitations">{translateRequired(locale, 'Scope and limitations')}</h2>
        <ul>
          {limitations.map((limitation) => (
            <li>{limitation}</li>
          ))}
        </ul>
      </section>
    </>
  ) : null}
  <section aria-labelledby="feature-sources">
    <h2 id="feature-sources">{translateRequired(locale, 'Sources and entered data')}</h2>
    {sources.length > 0 ? (
      <ul class="feature-links">
        {sources.map((source) => (
          <li>
            {source.url ? <a href={source.url}>{source.title}</a> : source.title} —{' '}
            {source.publisher}
          </li>
        ))}
      </ul>
    ) : (
      <p>
        {translateRequired(
          locale,
          'No product-specific dimension is preloaded for this feature. The live calculation uses the dimensions you enter; copy model-specific limits from current manuals.',
        )}
      </p>
    )}
    <p>
      <a href={pathForLocale('/methodology/', locale)}>
        {translateRequired(locale, 'Calculation methodology')}
      </a>{' '}
      ·{' '}
      <a href={pathForLocale('/methodology/reference-conventions/', locale)}>
        {translateRequired(locale, 'Measurement conventions')}
      </a>{' '}
      ·{' '}
      <a href={pathForLocale('/about/', locale)}>
        {translateRequired(locale, 'About and data sources')}
      </a>
    </p>
  </section>
  {relatedLinks.length > 0 && feature.kind !== 'hub' && !isIndexDirectory && (
    <nav aria-label={translateRequired(locale, 'Related next checks')}>
      <h2>{translateRequired(locale, 'What to check next')}</h2>
      <ul class="feature-links">
        {relatedLinks
          .filter((link) => link.href !== pageIntent.route)
          .map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
              <p>{link.description}</p>
            </li>
          ))}
      </ul>
    </nav>
  )}
</PageFamilyLayout>

<style>
  .feature-intro {
    max-width: 76ch;
    color: var(--color-text-secondary);
    font-size: var(--fs-md);
    line-height: 1.65;
  }

  .feature-links {
    display: grid;
    gap: var(--space-2);
    padding-left: var(--space-5);
  }

  .feature-links li {
    display: grid;
    gap: var(--space-1);
  }

  .feature-links li p {
    max-width: 68ch;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--fs-sm);
    line-height: 1.45;
  }

  section,
  nav {
    max-width: 82ch;
  }
</style>
