---
import FitAnswerTemplate from './templates/FitAnswerTemplate.astro';
import { evaluateFit, toDimensionDisplayRows } from '../../lib/fit';
import { buildWorkspaceConfigurationCheck, resolveMonitorWidth } from '../../lib/geometry';
import { renderWorkspaceDiagramMarkup } from '../../lib/diagram';
import { formatMeasurement } from '../../lib/units';
import type { BreadcrumbItem } from '../../lib/content';
import type { Dataset } from '../../lib/validation/dataset';
import { translate } from '../../i18n/text';

interface Props {
  breadcrumb: BreadcrumbItem[];
  h1: string;
  dataset: Dataset;
}

const { breadcrumb, h1, dataset } = Astro.props;
const desk = dataset.entities.find((entity) => entity.id === 'ent-desk-1400');
const monitor = dataset.entities.find((entity) => entity.id === 'ent-display-27in-16x9');
const gapRule = dataset.clearanceRules.find((rule) => rule.id === 'clr-monitor-gap');
const sideMarginRule = dataset.clearanceRules.find((rule) => rule.id === 'clr-desk-side-margin');
if (desk?.category !== 'desk' || monitor?.category !== 'display' || !gapRule || !sideMarginRule) {
  throw new Error('Spanish dual-monitor example is missing its shared model inputs.');
}
const deskWidthMm = desk.widthMm.valueMm;
const monitorWidthMm = resolveMonitorWidth(monitor).valueMm;
const gapMm = gapRule.recommendedMm?.valueMm;
const sideMarginMm = sideMarginRule.recommendedMm?.valueMm;
if (gapMm === undefined || sideMarginMm === undefined) {
  throw new Error('Spanish dual-monitor example needs gap and side-margin measurements.');
}
const { check } = buildWorkspaceConfigurationCheck({
  widthsMm: [monitorWidthMm, monitorWidthMm],
  gapMm,
  sideMarginRecommendedMm: sideMarginMm,
  deskWidthMm,
});
const assumptions = [
  'El ancho aproximado de cada monitor de 27 pulgadas se deriva de la diagonal y la relación 16:9, y se redondea al milímetro más cercano; el dispositivo real suele ser más ancho por el bisel.',
  `Profundidad del monitor con soporte: se suponen ${formatMeasurement(200)}.`,
  `Separación entre monitores: ${formatMeasurement(gapMm)}. ${gapRule.notes ?? ''}`.trim(),
  `Margen lateral recomendado: ${formatMeasurement(sideMarginMm)} a cada lado. ${sideMarginRule.notes ?? ''}`.trim(),
  'Una estimación basada solo en la pantalla no equivale a la huella completa del dispositivo, incluido el bisel y el soporte.',
];
const result = evaluateFit([check], assumptions);
const rows = toDimensionDisplayRows([check], result).map((row) => ({
  ...row,
  label: translate('es', row.label),
}));
const diagramId = 'es-desk-two-27in-diagram';
const diagramMarkup = renderWorkspaceDiagramMarkup({
  diagramId,
  viewportWidthPx: 640,
  viewportHeightPx: 360,
  paddingPx: 60,
  deskWidthMm,
  deskDepthMm: 700,
  monitorWidthMm,
  monitorDepthMm: 200,
  monitorCount: 2,
  gapMm,
  sideMarginMm,
  locale: 'es',
});
const diagramSummary = `Dos monitores de 27 pulgadas en un escritorio de ${formatMeasurement(deskWidthMm)}, con una separación de ${formatMeasurement(gapMm)} y un margen lateral recomendado de ${formatMeasurement(sideMarginMm)}.`;
---

<FitAnswerTemplate
  breadcrumb={breadcrumb}
  h1={h1}
  intro="Dos monitores de 27 pulgadas colocados uno al lado del otro necesitan aproximadamente este ancho de escritorio, incluida una separación cómoda y holgura lateral."
  state={result.state}
  rows={rows}
  diagramId={diagramId}
  diagramWidthPx={640}
  diagramHeightPx={360}
  diagramSummary={diagramSummary}
  diagramMarkup={diagramMarkup}
  tableCaption="Desglose del ancho del escritorio: requerido, recomendado, disponible y margen"
  assumptions={result.assumptions}
/>
