---
import PageFamilyLayout from '../PageFamilyLayout.astro';
import type { BreadcrumbItem } from '../../../lib/content';

interface ComparisonColumn {
  title: string;
  /** Display-ready values, one per rowLabel, already unit-formatted by the caller. */
  values: string[];
}

interface Props {
  breadcrumb: BreadcrumbItem[];
  h1: string;
  intro: string;
  rowLabels: string[];
  columns: ComparisonColumn[];
}

const { breadcrumb, h1, intro, rowLabels, columns } = Astro.props;
---

<PageFamilyLayout breadcrumb={breadcrumb} h1={h1}>
  <p>{intro}</p>
  <table class="comparison-table">
    <caption class="visually-hidden">{`${h1} comparison`}</caption>
    <thead>
      <tr>
        <th scope="col">Dimension</th>
        {columns.map((column) => (
          <th scope="col">{column.title}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rowLabels.map((label, rowIndex) => (
        <tr>
          <th scope="row">{label}</th>
          {columns.map((column) => (
            <td data-label={column.title}>{column.values[rowIndex]}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</PageFamilyLayout>

<style>
  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-sm);
  }

  .comparison-table th,
  .comparison-table td {
    text-align: left;
    padding: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  @media (max-width: 40rem) {
    .comparison-table :global(thead) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }

    .comparison-table,
    .comparison-table :global(tbody),
    .comparison-table :global(tr),
    .comparison-table :global(th),
    .comparison-table :global(td) {
      display: block;
      width: 100%;
    }

    .comparison-table :global(tbody tr) {
      margin-block-end: var(--space-3);
      padding: var(--space-2) var(--space-3);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
    }

    .comparison-table :global(tbody th) {
      padding: var(--space-2) 0;
      border-bottom: 1px solid var(--color-border);
      font-size: var(--fs-base);
    }

    .comparison-table :global(tbody td) {
      display: flex;
      justify-content: space-between;
      gap: var(--space-3);
      padding: var(--space-2) 0;
      border-bottom: 0;
    }

    .comparison-table :global(tbody td::before) {
      content: attr(data-label);
      color: var(--color-text-secondary);
      font-weight: 600;
    }
  }
</style>
