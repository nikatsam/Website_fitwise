---
import { dataset } from '../../data';
import { buildFurniturePlanningAnswer } from '../../lib/content/build-planning-example';
import { buildBreadcrumb, buildContentNavigationLinks } from '../../lib/content';
import {
  breadcrumbListStructuredData,
  buildPublicationBreadcrumbs,
  publicationStructuredData,
} from '../../lib/seo/metadata';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FamilyFactsTemplate from './templates/FamilyFactsTemplate.astro';

interface Props {
  pageIntentId: string;
}

const { pageIntentId } = Astro.props;
const pageIntent = dataset.pageIntents.find((intent) => intent.id === pageIntentId);
const publication = dataset.seoPublications.find((item) => item.pageIntentId === pageIntentId);
if (!pageIntent || !publication)
  throw new Error(`Missing published metadata for '${pageIntentId}'.`);

const answer = buildFurniturePlanningAnswer(pageIntent, dataset);
const breadcrumb = publication.indexable
  ? buildPublicationBreadcrumbs(
      pageIntent,
      publication,
      dataset.pageIntents,
      dataset.seoPublications,
    )
  : buildBreadcrumb(pageIntent.route, pageIntent.cluster);
const structuredData = publication.indexable
  ? publicationStructuredData(publication, breadcrumb)
  : [breadcrumbListStructuredData(publication.canonicalPath, breadcrumb)];
const relatedPages = buildContentNavigationLinks(
  pageIntent.id,
  dataset.pageIntents,
  dataset.seoPublications,
  dataset.routeDispositions,
);
---

<BaseLayout
  title={publication.title}
  description={publication.description}
  noindex={!publication.indexable}
  canonicalPath={publication.indexable ? publication.canonicalPath : undefined}
  language={publication.language}
  structuredData={structuredData}
>
  <FamilyFactsTemplate
    breadcrumb={breadcrumb}
    h1={publication.h1}
    intro={answer.intro}
    sections={answer.sections}
    sources={answer.sources}
    relatedPages={relatedPages}
  />
</BaseLayout>
