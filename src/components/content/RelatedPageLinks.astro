---
import type { ContentNavigationLink } from '../../lib/content/navigation';
import { localeFromPath } from '../../i18n/locale';
import { translateRequired } from '../../i18n/text';

interface Props {
  links: ContentNavigationLink[];
  heading?: string;
}

const { links, heading = 'Related planning guides' } = Astro.props;
const localizedHeading = translateRequired(localeFromPath(Astro.url.pathname), heading);
---

{links.length > 0 && (
  <nav class="related-pages" aria-label={localizedHeading}>
    <h2>{localizedHeading}</h2>
    <ul>
      {links.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
          <p>{link.description}</p>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .related-pages ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .related-pages li {
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
  }

  .related-pages a {
    font-weight: 700;
  }

  .related-pages p {
    margin: var(--space-1) 0 0;
    color: var(--color-text-secondary);
    font-size: var(--fs-sm);
  }
</style>
