---
import type { BreadcrumbItem } from '../../lib/content';

interface Props {
  breadcrumb: BreadcrumbItem[];
  h1: string;
}

const { breadcrumb, h1 } = Astro.props;
---

<article class="page-family">
  <nav class="page-family__breadcrumb" aria-label="Breadcrumb">
    <ol>
      {breadcrumb.map((item, index) => (
        <li>
          {index === breadcrumb.length - 1 ? (
            <span aria-current="page">{item.label}</span>
          ) : (
            <>
              <a href={item.href}>{item.label}</a>
              <span aria-hidden="true"> / </span>
            </>
          )}
        </li>
      ))}
    </ol>
  </nav>

  <h1>{h1}</h1>

  <div class="page-family__body">
    <slot />
  </div>
</article>

<style>
  .page-family {
    padding-block: var(--space-6);
  }

  .page-family__breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0 0 var(--space-3);
    padding: 0;
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
  }

  .page-family__breadcrumb li {
    display: inline-flex;
    align-items: center;
  }

  .page-family__breadcrumb a {
    color: var(--color-text-secondary);
  }

  .page-family__body {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-4);
  }
</style>
