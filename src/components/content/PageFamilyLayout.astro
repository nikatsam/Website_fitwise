---
import CalculatorPageShell from '../layout/CalculatorPageShell.astro';
import type { BreadcrumbItem } from '../../lib/content';

interface Props {
  breadcrumb: BreadcrumbItem[];
  h1: string;
}

const { breadcrumb, h1 } = Astro.props;
const hasPurpose = Astro.slots.has('purpose');
---

<CalculatorPageShell breadcrumb={breadcrumb} h1={h1}>
  {hasPurpose && <slot name="purpose" slot="purpose" />}
  <slot />
</CalculatorPageShell>
