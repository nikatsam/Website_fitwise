---
import AssumptionList from '../fit/AssumptionList.astro';
import CalculatorStep from '../fit/CalculatorStep.astro';
import DimensionTable from '../fit/DimensionTable.astro';
import FitSummary from '../fit/FitSummary.astro';
import MeasurementFieldHelp from '../fit/MeasurementFieldHelp.astro';
import UnitToggle from '../fit/UnitToggle.astro';
import { evaluateFit, toDimensionDisplayRows } from '../../lib/fit';
import { buildObjectFitPlan } from '../../lib/geometry';

const DEFAULTS = {
  itemName: 'Furniture item',
  itemWidthMm: 800,
  itemDepthMm: 600,
  itemHeightMm: 900,
  spaceWidthMm: 3000,
  spaceDepthMm: 3500,
  spaceHeightMm: 2500,
  clearanceEachSideMm: 0,
  doorwayWidthMm: 900,
  doorwayHeightMm: 2000,
  corridorWidthMm: 1000,
  requestedQuantity: 1,
  itemGapMm: 0,
};

const sample = buildObjectFitPlan({
  objectWidthMm: DEFAULTS.itemWidthMm,
  objectDepthMm: DEFAULTS.itemDepthMm,
  objectHeightMm: DEFAULTS.itemHeightMm,
  spaceWidthMm: DEFAULTS.spaceWidthMm,
  spaceDepthMm: DEFAULTS.spaceDepthMm,
  spaceHeightMm: DEFAULTS.spaceHeightMm,
  clearanceEachSideMm: DEFAULTS.clearanceEachSideMm,
  requestedQuantity: DEFAULTS.requestedQuantity,
  itemGapMm: DEFAULTS.itemGapMm,
});
const assumptions = [
  'Example dimensions are editable placeholders, not a standard item, room, doorway or recommended clearance.',
  'Room placement checks use rectangular footprints, two 90-degree floor orientations and an upright height check; they do not model irregular walls, alcoves, slopes or tilt.',
  'Quantity is a maximum rectangular single-layer grid estimate with one chosen gap between adjacent items; it excludes stacking, supports, access lanes and non-rectangular obstacles.',
];
const initialResult = evaluateFit(sample.checks, assumptions);
const initialRows = toDimensionDisplayRows(sample.checks, initialResult);
const initialOrientation =
  sample.orientation === 'width-depth' ? 'width by depth' : 'depth by width';
const initialReport = `Best floor orientation: ${initialOrientation}. Maximum single-layer grid estimate: ${sample.quantityCapacity} item(s).`;
---

<div class="universal-fitcheck calculator-split" data-universal-fitcheck>
  <form class="universal-fitcheck__form" data-universal-fitcheck-form novalidate>
    <p class="fit-example-notice" data-fit-example-notice role="note">
      <strong>Example setup.</strong> These starter dimensions are illustrative. Enter the item's
      measured outer size and your actual space before relying on the fit review.
    </p>
    <CalculatorStep
      step={1}
      title="What are you fitting?"
      description="Enter a name and measured outer dimensions, including packaging if checking delivery."
    >
      <div class="field">
        <label for="fit-item-name">Item name (optional)</label>
        <input
          id="fit-item-name"
          name="itemName"
          type="text"
          value={DEFAULTS.itemName}
          maxlength="80"
        />
      </div>
      <div class="field-grid">
        <div class="field">
          <label for="fit-item-width">Width</label>
          <input
            id="fit-item-width"
            name="itemWidth"
            type="text"
            inputmode="text"
            value="80 cm"
            aria-describedby="fit-item-width-error fit-item-width-help"
          />
          <span class="field__error" id="fit-item-width-error" role="alert"></span>
          <MeasurementFieldHelp
            calculator="universal"
            fieldId="fit-item-width"
            id="fit-item-width-help"
          />
        </div>
        <div class="field">
          <label for="fit-item-depth">Depth</label>
          <input
            id="fit-item-depth"
            name="itemDepth"
            type="text"
            inputmode="text"
            value="60 cm"
            aria-describedby="fit-item-depth-error fit-item-depth-help"
          />
          <span class="field__error" id="fit-item-depth-error" role="alert"></span>
          <MeasurementFieldHelp
            calculator="universal"
            fieldId="fit-item-depth"
            id="fit-item-depth-help"
          />
        </div>
        <div class="field">
          <label for="fit-item-height">Height</label>
          <input
            id="fit-item-height"
            name="itemHeight"
            type="text"
            inputmode="text"
            value="90 cm"
            aria-describedby="fit-item-height-error fit-item-height-help"
          />
          <span class="field__error" id="fit-item-height-error" role="alert"></span>
          <MeasurementFieldHelp
            calculator="universal"
            fieldId="fit-item-height"
            id="fit-item-height-help"
          />
        </div>
      </div>
    </CalculatorStep>

    <CalculatorStep
      step={2}
      title="Where does it need to fit?"
      description="Measure the usable inside dimensions of the destination space."
    >
      <div class="field-grid">
        <div class="field">
          <label for="fit-space-width">Inside width</label>
          <input
            id="fit-space-width"
            name="spaceWidth"
            type="text"
            inputmode="text"
            value="3 m"
            aria-describedby="fit-space-width-error fit-space-width-help"
          />
          <span class="field__error" id="fit-space-width-error" role="alert"></span>
          <MeasurementFieldHelp
            calculator="universal"
            fieldId="fit-space-width"
            id="fit-space-width-help"
          />
        </div>
        <div class="field">
          <label for="fit-space-depth">Inside depth</label>
          <input
            id="fit-space-depth"
            name="spaceDepth"
            type="text"
            inputmode="text"
            value="3.5 m"
            aria-describedby="fit-space-depth-error fit-space-depth-help"
          />
          <span class="field__error" id="fit-space-depth-error" role="alert"></span>
          <MeasurementFieldHelp
            calculator="universal"
            fieldId="fit-space-depth"
            id="fit-space-depth-help"
          />
        </div>
        <div class="field">
          <label for="fit-space-height">Inside height</label>
          <input
            id="fit-space-height"
            name="spaceHeight"
            type="text"
            inputmode="text"
            value="2.5 m"
            aria-describedby="fit-space-height-error fit-space-height-help"
          />
          <span class="field__error" id="fit-space-height-error" role="alert"></span>
          <MeasurementFieldHelp
            calculator="universal"
            fieldId="fit-space-height"
            id="fit-space-height-help"
          />
        </div>
      </div>
      <p class="field__note">
        Accepted units: mm, cm, m, in, ft, or ft/in. You can separate the number and unit with a
        space; a bare number defaults to mm.
      </p>
      <div class="field">
        <label for="fit-clearance">Extra planning space on each side (optional)</label>
        <input
          id="fit-clearance"
          name="clearance"
          type="text"
          inputmode="text"
          value="0 mm"
          aria-describedby="fit-clearance-error fit-clearance-help"
        />
        <span class="field__error" id="fit-clearance-error" role="alert"></span>
        <MeasurementFieldHelp
          calculator="universal"
          fieldId="fit-clearance"
          id="fit-clearance-help"
        />
      </div>
      <div class="field">
        <label for="fit-orientation">Floor orientation</label>
        <select id="fit-orientation" name="orientation" aria-describedby="fit-orientation-help">
          <option value="auto" selected>
            Try both rectangular orientations
          </option>
          <option value="width-depth">Keep width along space width</option>
          <option value="depth-width">Rotate 90 degrees</option>
        </select>
        <MeasurementFieldHelp
          calculator="universal"
          fieldId="fit-orientation"
          id="fit-orientation-help"
        />
      </div>
    </CalculatorStep>

    <details class="universal-fitcheck__optional">
      <summary>Optional route and quantity checks</summary>
      <CalculatorStep
        step={3}
        title="Extra space and access"
        description="Add side allowances, a delivery route, or a single-layer quantity estimate."
      >
        <label class="check-option">
          <input type="checkbox" id="fit-check-route" name="checkRoute" />
          Check a doorway and corridor for upright passage
        </label>
        <div class="field-grid" data-fit-route-fields hidden>
          <div class="field">
            <label for="fit-door-width">Clear doorway width</label>
            <input
              id="fit-door-width"
              name="doorwayWidth"
              type="text"
              inputmode="text"
              value="90 cm"
              aria-describedby="fit-door-width-error fit-door-width-help"
            />
            <span class="field__error" id="fit-door-width-error" role="alert"></span>
            <MeasurementFieldHelp
              calculator="universal"
              fieldId="fit-door-width"
              id="fit-door-width-help"
            />
          </div>
          <div class="field">
            <label for="fit-door-height">Clear doorway height</label>
            <input
              id="fit-door-height"
              name="doorwayHeight"
              type="text"
              inputmode="text"
              value="2 m"
              aria-describedby="fit-door-height-error fit-door-height-help"
            />
            <span class="field__error" id="fit-door-height-error" role="alert"></span>
            <MeasurementFieldHelp
              calculator="universal"
              fieldId="fit-door-height"
              id="fit-door-height-help"
            />
          </div>
          <div class="field">
            <label for="fit-corridor-width">Narrowest corridor width</label>
            <input
              id="fit-corridor-width"
              name="corridorWidth"
              type="text"
              inputmode="text"
              value="1 m"
              aria-describedby="fit-corridor-width-error fit-corridor-width-help"
            />
            <span class="field__error" id="fit-corridor-width-error" role="alert"></span>
            <MeasurementFieldHelp
              calculator="universal"
              fieldId="fit-corridor-width"
              id="fit-corridor-width-help"
            />
          </div>
        </div>
        <div class="field-grid">
          <div class="field">
            <label for="fit-quantity">Identical items to place</label>
            <input
              id="fit-quantity"
              name="quantity"
              type="number"
              min="1"
              step="1"
              value={DEFAULTS.requestedQuantity}
              aria-describedby="fit-quantity-error"
            />
            <span class="field__error" id="fit-quantity-error" role="alert"></span>
          </div>
          <div class="field">
            <label for="fit-item-gap">Gap between items (optional)</label>
            <input
              id="fit-item-gap"
              name="itemGap"
              type="text"
              inputmode="text"
              value="0 mm"
              aria-describedby="fit-item-gap-error fit-item-gap-help"
            />
            <span class="field__error" id="fit-item-gap-error" role="alert"></span>
            <MeasurementFieldHelp
              calculator="universal"
              fieldId="fit-item-gap"
              id="fit-item-gap-help"
            />
          </div>
        </div>
      </CalculatorStep>
    </details>

    <UnitToggle />
  </form>

  <section class="universal-fitcheck__results calculator-split__result" aria-label="Fit review">
    <FitSummary
      id="universal-fit-summary"
      resultId="universal-fit-table"
      state={initialResult.state}
      rows={initialRows}
      resultOrigin="example"
    />
    <p class="universal-fitcheck__orientation" data-fit-orientation>
      {initialReport}
    </p>
    <DimensionTable
      id="universal-fit-table"
      rows={initialRows}
      caption="Required, recommended, available and remaining dimensions for the fit review"
    />
    <AssumptionList id="universal-fit-assumptions" assumptions={assumptions} />
    <button type="button" class="copy-report" data-copy-fit-report>
      Copy fit review
    </button>
    <p class="copy-report__status" data-copy-fit-status aria-live="polite"></p>
  </section>
</div>

<script>
  import '../../scripts/universal-fitcheck';
</script>

<style>
  .universal-fitcheck {
    display: grid;
    gap: var(--space-6);
  }

  .universal-fitcheck__form,
  .universal-fitcheck__results {
    display: grid;
    align-content: start;
    gap: var(--space-5);
    min-width: 0;
  }

  .universal-fitcheck__form {
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-raised);
  }

  .fit-example-notice {
    margin: 0;
    padding: var(--space-3);
    border-left: 0.2rem solid var(--color-accent-1);
    background: var(--color-surface);
    font-size: var(--fs-sm);
    line-height: 1.5;
  }

  .universal-fitcheck__optional > summary {
    cursor: pointer;
    font-weight: 700;
  }

  .field-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
    gap: var(--space-3);
  }

  .field {
    display: grid;
    gap: var(--space-1);
    min-width: 0;
  }

  .field label {
    color: var(--color-text-secondary);
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .field input,
  .field select {
    width: 100%;
    min-width: 0;
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text-primary);
    font: inherit;
  }

  .field__error {
    min-height: 1.2em;
    color: var(--color-state-no-fit-fg);
    font-size: var(--fs-xs);
  }

  .field__note {
    line-height: 1.5;
  }

  [data-fit-route-fields][hidden] {
    display: none;
  }

  .check-option {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .universal-fitcheck__orientation {
    margin: 0;
    padding: var(--space-3);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
    font-size: var(--fs-sm);
  }

  @media (max-width: 61.999rem) {
    .universal-fitcheck {
      padding-bottom: 4.5rem;
    }
  }

  .copy-report {
    justify-self: start;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface-raised);
    color: var(--color-text-primary);
    font-weight: 600;
    cursor: pointer;
  }

  .copy-report__status {
    margin: calc(-1 * var(--space-4)) 0 0;
    color: var(--color-text-secondary);
    font-size: var(--fs-xs);
  }
</style>
