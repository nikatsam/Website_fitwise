---
import AssumptionList from '../fit/AssumptionList.astro';
import CalculatorStep from '../fit/CalculatorStep.astro';
import DimensionTable from '../fit/DimensionTable.astro';
import ExampleDataNotice from '../fit/ExampleDataNotice.astro';
import FitSummary from '../fit/FitSummary.astro';
import MeasurementFieldHelp from '../fit/MeasurementFieldHelp.astro';
import UnitToggle from '../fit/UnitToggle.astro';
import ScaleDiagram from '../diagram/ScaleDiagram.astro';
import { evaluateFit, toDimensionDisplayRows } from '../../lib/fit';
import { buildRugFitPlan } from '../../lib/geometry';
import { renderRugDiagramMarkup } from '../../lib/diagram';
import { formatMeasurement } from '../../lib/units';
import { localeFromPath } from '../../i18n/locale';
import { translateRequired, translateTemplate } from '../../i18n/text';

const DIAGRAM_ID = 'rug-fitcheck-diagram';
const DIAGRAM_WIDTH = 480;
const DIAGRAM_HEIGHT = 620;
const locale = localeFromPath(Astro.url.pathname);
const copy = (source: string) => translateRequired(locale, source);
const template = (source: string, values: Record<string, string | number>) =>
  translateTemplate(locale, source, values);
const DEFAULTS = {
  roomWidthMm: 4000,
  roomDepthMm: 5000,
  rugWidthMm: 2400,
  rugDepthMm: 3000,
  wallGapEachSideMm: 100,
  orientation: 'auto' as const,
  checkFurniture: true,
  coverageMode: 'full-footprint' as const,
  furnitureWidthMm: 1800,
  furnitureDepthMm: 2000,
  furnitureMarginEachSideMm: 100,
  frontOverlapMm: 150,
  frontExtensionMm: 500,
};

function makeAssumptions(values: typeof DEFAULTS): string[] {
  return [
    copy(
      'Example values are illustrative placeholders, not recommended rug dimensions or styling advice.',
    ),
    copy(
      'The room and rug are treated as axis-aligned rectangles; the orientation control tests the rug rotated 90 degrees.',
    ),
    template(
      'The {measurement} room border is an extra user-selected target on every rug edge, not a universal design rule.',
      {
        measurement: formatMeasurement(values.wallGapEachSideMm),
      },
    ),
    values.checkFurniture
      ? values.coverageMode === 'full-footprint'
        ? template(
            'The complete {width} by {depth} furniture/use footprint is compared with the rug, plus the user-selected {margin} border.',
            {
              width: formatMeasurement(values.furnitureWidthMm),
              depth: formatMeasurement(values.furnitureDepthMm),
              margin: formatMeasurement(values.furnitureMarginEachSideMm),
            },
          )
        : template(
            'The front-edge check compares the entered {overlap} overlap and {extension} extension. It does not infer actual furniture leg positions.',
            {
              overlap: formatMeasurement(values.frontOverlapMm),
              extension: formatMeasurement(values.frontExtensionMm ?? 0),
            },
          )
      : copy('Furniture coverage is disabled; only rug-to-room dimensions are checked.'),
    copy(
      'The diagram centers the rug in the room for a proportional comparison. It does not choose furniture placement, style, colors, irregular shapes or diagonal orientations.',
    ),
  ];
}

function getDiagramSummary(
  values: typeof DEFAULTS,
  rugWidthMm: number,
  rugDepthMm: number,
): string {
  const relationship = !values.checkFurniture
    ? copy('Furniture coverage is not checked.')
    : values.coverageMode === 'full-footprint'
      ? template('Full furniture/use footprint {width} by {depth} is checked against the rug.', {
          width: formatMeasurement(values.furnitureWidthMm),
          depth: formatMeasurement(values.furnitureDepthMm),
        })
      : template(
          'Front-edge overlap {overlap} and forward extension {extension} are user-selected.',
          {
            overlap: formatMeasurement(values.frontOverlapMm),
            extension: formatMeasurement(values.frontExtensionMm),
          },
        );
  return template(
    'Centered rectangular room and rug comparison. Room {roomWidth} by {roomDepth}. Rug {rugWidth} by {rugDepth} in the selected orientation. {relationship} This is not a complete floor-plan placement tool.',
    {
      roomWidth: formatMeasurement(values.roomWidthMm),
      roomDepth: formatMeasurement(values.roomDepthMm),
      rugWidth: formatMeasurement(rugWidthMm),
      rugDepth: formatMeasurement(rugDepthMm),
      relationship,
    },
  );
}

const initialPlan = buildRugFitPlan(DEFAULTS);
const initialAssumptions = makeAssumptions(DEFAULTS);
const initialResult = evaluateFit(initialPlan.checks, initialAssumptions);
const initialRows = toDimensionDisplayRows(initialPlan.checks, initialResult).map((row) => ({
  ...row,
  label: copy(row.label),
}));
const initialDiagram = renderRugDiagramMarkup({
  diagramId: DIAGRAM_ID,
  locale,
  ...DEFAULTS,
  orientation: initialPlan.orientation,
});
const initialDiagramSummary = getDiagramSummary(
  DEFAULTS,
  initialPlan.rugWidthOnRoomWidthMm,
  initialPlan.rugDepthOnRoomDepthMm,
);
---

<div
  class="rug-fitcheck calculator-split"
  data-rug-fitcheck
  data-fit-result-scope
  data-diagram-id={DIAGRAM_ID}
>
  <form class="rug-fitcheck__form" data-rug-fitcheck-form data-core-progressive-form novalidate>
    <ExampleDataNotice
      note={copy(
        'Replace the sample room, rug and furniture/use measurements with your own. Sample values are not recommended rug dimensions.',
      )}
    />

    <CalculatorStep
      step={1}
      title={copy('Measure the room and rug')}
      description={copy(
        'Enter clear inside room dimensions and the rug’s laid-flat outside dimensions.',
      )}
    >
      <div class="field-grid">
        <div class="field">
          <label for="rug-room-width">{copy('Inside room width')}</label>
          <input
            id="rug-room-width"
            name="roomWidthMm"
            type="text"
            inputmode="text"
            value={formatMeasurement(DEFAULTS.roomWidthMm)}
            aria-describedby="rug-room-width-error rug-room-width-help"
          />
          <span class="field__error" id="rug-room-width-error" role="alert"></span>
          <MeasurementFieldHelp
            calculator="rug"
            fieldId="rug-room-width"
            id="rug-room-width-help"
          />
        </div>
        <div class="field">
          <label for="rug-room-depth">{copy('Inside room depth')}</label>
          <input
            id="rug-room-depth"
            name="roomDepthMm"
            type="text"
            inputmode="text"
            value={formatMeasurement(DEFAULTS.roomDepthMm)}
            aria-describedby="rug-room-depth-error rug-room-depth-help"
          />
          <span class="field__error" id="rug-room-depth-error" role="alert"></span>
          <MeasurementFieldHelp
            calculator="rug"
            fieldId="rug-room-depth"
            id="rug-room-depth-help"
          />
        </div>
        <div class="field">
          <label for="rug-width">{copy('Rug outside width')}</label>
          <input
            id="rug-width"
            name="rugWidthMm"
            type="text"
            inputmode="text"
            value={formatMeasurement(DEFAULTS.rugWidthMm)}
            aria-describedby="rug-width-error rug-width-help"
          />
          <span class="field__error" id="rug-width-error" role="alert"></span>
          <MeasurementFieldHelp calculator="rug" fieldId="rug-width" id="rug-width-help" />
        </div>
        <div class="field">
          <label for="rug-depth">{copy('Rug outside depth')}</label>
          <input
            id="rug-depth"
            name="rugDepthMm"
            type="text"
            inputmode="text"
            value={formatMeasurement(DEFAULTS.rugDepthMm)}
            aria-describedby="rug-depth-error rug-depth-help"
          />
          <span class="field__error" id="rug-depth-error" role="alert"></span>
          <MeasurementFieldHelp calculator="rug" fieldId="rug-depth" id="rug-depth-help" />
        </div>
      </div>
      <details class="rug-fitcheck__advanced">
        <summary>{copy('Advanced options · Optional')}</summary>
        <section data-advanced-options-group aria-labelledby="rug-orientation-heading">
          <h3 id="rug-orientation-heading">{copy('Rug orientation')}</h3>
          <div class="field">
            <label for="rug-orientation">{copy('Room-axis alignment')}</label>
            <select id="rug-orientation" name="orientation" aria-describedby="rug-orientation-help">
              <option value="auto" selected>
                {copy('Try both 90-degree orientations')}
              </option>
              <option value="width-depth">{copy('Keep rug width along room width')}</option>
              <option value="depth-width">{copy('Rotate rug 90 degrees')}</option>
            </select>
            <MeasurementFieldHelp
              calculator="rug"
              fieldId="rug-orientation"
              id="rug-orientation-help"
            />
          </div>
        </section>
        <section data-advanced-options-group aria-labelledby="rug-wall-border-heading">
          <h3 id="rug-wall-border-heading">{copy('Room-edge target')}</h3>
          <div class="field">
            <label for="rug-wall-gap">
              {copy('Extra rug-to-wall border on each side (optional)')}
            </label>
            <input
              id="rug-wall-gap"
              name="wallGapEachSideMm"
              type="text"
              inputmode="text"
              value={formatMeasurement(DEFAULTS.wallGapEachSideMm)}
              aria-describedby="rug-wall-gap-error rug-wall-gap-help"
            />
            <span class="field__error" id="rug-wall-gap-error" role="alert"></span>
            <MeasurementFieldHelp calculator="rug" fieldId="rug-wall-gap" id="rug-wall-gap-help" />
          </div>
          <p class="field__note">
            {copy('The border is your chosen layout target, not a universal rug-sizing rule.')}
          </p>
        </section>
      </details>
    </CalculatorStep>

    <CalculatorStep
      step={2}
      title={copy('Choose what the rug should cover')}
      description={copy(
        'You can check the rug alone or compare a measured furniture/use footprint.',
      )}
    >
      <label class="rug-fitcheck__check-option">
        <input id="rug-check-furniture" name="checkFurniture" type="checkbox" checked />
        {copy('Also check a furniture/use footprint against the rug')}
      </label>
      <div data-rug-furniture-controls>
        <div class="field-grid">
          <div class="field">
            <label for="rug-furniture-width">{copy('Furniture/use footprint width')}</label>
            <input
              id="rug-furniture-width"
              name="furnitureWidthMm"
              type="text"
              inputmode="text"
              value={formatMeasurement(DEFAULTS.furnitureWidthMm)}
              aria-describedby="rug-furniture-width-error rug-furniture-width-help"
            />
            <span class="field__error" id="rug-furniture-width-error" role="alert"></span>
            <MeasurementFieldHelp
              calculator="rug"
              fieldId="rug-furniture-width"
              id="rug-furniture-width-help"
            />
          </div>
          <div class="field">
            <label for="rug-furniture-depth">{copy('Furniture/use footprint depth')}</label>
            <input
              id="rug-furniture-depth"
              name="furnitureDepthMm"
              type="text"
              inputmode="text"
              value={formatMeasurement(DEFAULTS.furnitureDepthMm)}
              aria-describedby="rug-furniture-depth-error rug-furniture-depth-help"
            />
            <span class="field__error" id="rug-furniture-depth-error" role="alert"></span>
            <MeasurementFieldHelp
              calculator="rug"
              fieldId="rug-furniture-depth"
              id="rug-furniture-depth-help"
            />
          </div>
        </div>
        <div class="field">
          <label for="rug-coverage-mode">{copy('Coverage mode')}</label>
          <select
            id="rug-coverage-mode"
            name="coverageMode"
            aria-describedby="rug-coverage-mode-note"
          >
            <option value="full-footprint" selected>
              {copy('Keep the full footprint on the rug')}
            </option>
            <option value="front-edge">{copy('Check a user-selected front-edge overlap')}</option>
          </select>
          <p id="rug-coverage-mode-note" class="field__note">
            {copy(
              'For a dining setup, enter the rectangular table/chair-use zone you want covered. For a bed or sofa, enter the footprint you want on the rug.',
            )}
          </p>
        </div>
        <details class="rug-fitcheck__advanced">
          <summary>{copy('Advanced options · Optional')}</summary>
          <section data-advanced-options-group aria-labelledby="rug-furniture-border-heading">
            <h3 id="rug-furniture-border-heading">{copy('Furniture-edge target')}</h3>
            <div class="field">
              <label
                for="rug-furniture-margin"
                id="rug-furniture-margin-label"
                data-rug-furniture-margin-label
              >
                {copy('Extra rug border around the full footprint (optional)')}
              </label>
              <input
                id="rug-furniture-margin"
                name="furnitureMarginEachSideMm"
                type="text"
                inputmode="text"
                value={formatMeasurement(DEFAULTS.furnitureMarginEachSideMm)}
                aria-describedby="rug-furniture-margin-error rug-furniture-margin-help"
              />
              <span class="field__error" id="rug-furniture-margin-error" role="alert"></span>
              <MeasurementFieldHelp
                calculator="rug"
                fieldId="rug-furniture-margin"
                id="rug-furniture-margin-help"
              />
            </div>
          </section>
        </details>
        <section data-rug-front-fields hidden aria-labelledby="rug-front-options-heading">
          <h3 id="rug-front-options-heading">{copy('Choose the front-edge relationship')}</h3>
          <p class="field__note">
            {copy(
              'Enter the overlap and projection you want. No universal front-leg placement is assumed.',
            )}
          </p>
          <div class="field-grid">
            <div class="field">
              <label for="rug-front-overlap">
                {copy('Rug overlap beneath the furniture front edge')}
              </label>
              <input
                id="rug-front-overlap"
                name="frontOverlapMm"
                type="text"
                inputmode="text"
                value={formatMeasurement(DEFAULTS.frontOverlapMm)}
                aria-describedby="rug-front-overlap-error rug-front-overlap-help"
              />
              <span class="field__error" id="rug-front-overlap-error" role="alert"></span>
              <MeasurementFieldHelp
                calculator="rug"
                fieldId="rug-front-overlap"
                id="rug-front-overlap-help"
              />
            </div>
            <div class="field">
              <label for="rug-front-extension">
                {copy('Rug extension in front of the furniture')}
              </label>
              <input
                id="rug-front-extension"
                name="frontExtensionMm"
                type="text"
                inputmode="text"
                value={formatMeasurement(DEFAULTS.frontExtensionMm)}
                aria-describedby="rug-front-extension-error rug-front-extension-help"
              />
              <span class="field__error" id="rug-front-extension-error" role="alert"></span>
              <MeasurementFieldHelp
                calculator="rug"
                fieldId="rug-front-extension"
                id="rug-front-extension-help"
              />
            </div>
          </div>
        </section>
      </div>
      <p class="field__note">
        {copy(
          'For an incomplete furniture measurement, uncheck the footprint test. Any front-edge overlap is checked as a user-entered dimension, not inferred from actual leg locations.',
        )}
      </p>
    </CalculatorStep>

    <UnitToggle />
  </form>

  <section
    class="rug-fitcheck__result calculator-split__result"
    aria-label={copy('Rug fit result')}
  >
    <FitSummary
      id="rug-fitcheck-summary"
      resultId="rug-fitcheck-table"
      state={initialResult.state}
      rows={initialRows}
      resultOrigin="example"
    />
    <p class="rug-fitcheck__orientation" data-rug-orientation>
      {initialPlan.orientation === 'width-depth'
        ? copy('Rug width runs along the room width.')
        : copy('Rug is rotated 90 degrees against the room axes.')}
    </p>
    <div
      class="rug-fitcheck__visual"
      aria-label={copy('Rug and furniture footprint visualization')}
    >
      <ScaleDiagram
        id={DIAGRAM_ID}
        widthPx={DIAGRAM_WIDTH}
        heightPx={DIAGRAM_HEIGHT}
        summary={initialDiagramSummary}
      >
        <Fragment set:html={initialDiagram} />
      </ScaleDiagram>
      <p class="rug-fitcheck__diagram-key">
        {copy(
          'Dashed outline/line: measured room or furniture edge. Dotted outline/line: your selected target. Blue fill: rug. Green fill: furniture/use footprint. In front-edge mode, the dashed line marks the furniture front.',
        )}
      </p>
      <p class="rug-fitcheck__diagram-note">
        {copy(
          'Centered rectangular comparison only; it does not place furniture in a floor plan or infer styling preferences.',
        )}
      </p>
    </div>
    <DimensionTable
      id="rug-fitcheck-table"
      rows={initialRows}
      caption="Rug-to-room dimensions and selected rug-to-furniture coverage dimensions"
    />
    <AssumptionList id="rug-fitcheck-assumptions" assumptions={initialAssumptions} />
  </section>
</div>

<script>
  import '../../scripts/rug-fitcheck';
</script>

<style>
  .rug-fitcheck {
    display: grid;
    gap: var(--space-6);
  }

  .rug-fitcheck__form,
  .rug-fitcheck__result {
    display: grid;
    align-content: start;
    gap: var(--space-5);
    min-width: 0;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-raised);
  }

  .field-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
    gap: var(--space-3);
  }

  .field {
    display: grid;
    gap: var(--space-1);
    min-width: 0;
  }

  .field label {
    color: var(--color-text-secondary);
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .field input,
  .field select {
    width: 100%;
    min-width: 0;
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text-primary);
    font: inherit;
  }

  .field__error {
    min-height: 1.2em;
    color: var(--color-state-no-fit-fg);
    font-size: var(--fs-xs);
  }

  .field__note,
  .rug-fitcheck__diagram-key,
  .rug-fitcheck__diagram-note {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--fs-sm);
    line-height: 1.5;
  }

  .rug-fitcheck__check-option {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    font-weight: 600;
  }

  .rug-fitcheck__check-option input {
    accent-color: var(--color-accent-1);
  }

  [data-rug-furniture-controls][hidden],
  [data-rug-front-fields][hidden] {
    display: none;
  }

  .rug-fitcheck__orientation {
    margin: 0;
    padding: var(--space-3);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
    font-size: var(--fs-sm);
  }

  .rug-fitcheck__visual {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
  }

  @media (max-width: 61.999rem) {
    .rug-fitcheck {
      padding-bottom: 4.5rem;
    }
  }
</style>
