---
import FitSummary from '../fit/FitSummary.astro';
import DimensionTable from '../fit/DimensionTable.astro';
import AssumptionList from '../fit/AssumptionList.astro';
import UnitToggle from '../fit/UnitToggle.astro';
import ScaleDiagram from '../diagram/ScaleDiagram.astro';
import { evaluateFit, toDimensionDisplayRows } from '../../lib/fit';
import {
  buildBedRoomChecks,
  buildDoorSwingCheck,
  buildDrawerPullOutCheck,
  computeBedFootprint,
} from '../../lib/geometry';
import { renderBedroomDiagramMarkup } from '../../lib/diagram';
import { BEDROOM_FIT_PRESETS, DEFAULT_BEDROOM_FIT_PRESET_KEY } from '../../lib/fitcheck/presets';

const DEFAULTS = {
  roomWidthMm: 3000,
  roomLengthMm: 3600,
  bedPreset: DEFAULT_BEDROOM_FIT_PRESET_KEY,
  orientation: 'portrait' as const,
  sideClearanceMm: 600,
  footClearanceMm: 600,
  customMattressWidthMm: 1600,
  customMattressLengthMm: 2000,
  nightstandCount: 0,
  nightstandWidthMm: 450,
  nightstandDepthMm: 400,
  includeWardrobeDoor: false,
  wardrobeDoorLeafWidthMm: 450,
  wardrobeDoorAngleDegrees: 90,
  wardrobeObstacleGapMm: 0,
  includeDresserDrawer: false,
  dresserDrawerPullOutMm: 300,
  dresserObstacleGapMm: 0,
};

const DIAGRAM_ID = 'bedroom-diagram';
const VIEWPORT_WIDTH_PX = 640;
const VIEWPORT_HEIGHT_PX = 480;
const DIAGRAM_PADDING_PX = 60;

const preset = BEDROOM_FIT_PRESETS.find((item) => item.key === DEFAULTS.bedPreset)!;
const frameAllowance = preset.frameAllowanceMm;
const nightstandWidthsMm = Array.from(
  { length: DEFAULTS.nightstandCount },
  () => DEFAULTS.nightstandWidthMm,
);

const checks = buildBedRoomChecks({
  mattressWidthMm: preset.mattressWidthMm,
  mattressLengthMm: preset.mattressLengthMm,
  frameAllowanceMm: frameAllowance,
  orientation: DEFAULTS.orientation,
  sideClearanceRecommendedMm: DEFAULTS.sideClearanceMm,
  footClearanceRecommendedMm: DEFAULTS.footClearanceMm,
  roomWidthMm: DEFAULTS.roomWidthMm,
  roomLengthMm: DEFAULTS.roomLengthMm,
  nightstandWidthsMm,
  nightstandDepthMm: DEFAULTS.nightstandCount > 0 ? DEFAULTS.nightstandDepthMm : 0,
});

const assumptions = [
  `Bed preset: ${preset.label}. ${preset.note}`,
  `Selected side-clearance target: ${DEFAULTS.sideClearanceMm} mm per side; selected foot-clearance target: ${DEFAULTS.footClearanceMm} mm. Adjust these to your room/use; these are editable planning assumptions, not code minimums.`,
  `Nightstands: ${DEFAULTS.nightstandCount}. Their ${DEFAULTS.nightstandWidthMm} × ${DEFAULTS.nightstandDepthMm} mm starting dimensions are editable placeholders. Tables are modeled flush beside the headboard with no inter-object gap.`,
  'The scale diagram shows the bed and bedside-table footprints only. Optional wardrobe/drawer checks compare user-measured gaps and are not drawn to scale.',
];

const interactionChecks = [
  ...(DEFAULTS.includeWardrobeDoor
    ? [
        buildDoorSwingCheck({
          doorLeafWidthMm: DEFAULTS.wardrobeDoorLeafWidthMm,
          openingAngleDegrees: DEFAULTS.wardrobeDoorAngleDegrees,
          obstacleGapMm: DEFAULTS.wardrobeObstacleGapMm,
        }),
      ]
    : []),
  ...(DEFAULTS.includeDresserDrawer
    ? [
        buildDrawerPullOutCheck({
          drawerPullOutMm: DEFAULTS.dresserDrawerPullOutMm,
          obstacleGapMm: DEFAULTS.dresserObstacleGapMm,
        }),
      ]
    : []),
];
const allChecks = [...checks, ...interactionChecks];

const result = evaluateFit(allChecks, assumptions);
const rows = toDimensionDisplayRows(allChecks, result);

const footprint = computeBedFootprint(
  preset.mattressWidthMm,
  preset.mattressLengthMm,
  frameAllowance,
);
const diagramMarkup = renderBedroomDiagramMarkup({
  diagramId: DIAGRAM_ID,
  viewportWidthPx: VIEWPORT_WIDTH_PX,
  viewportHeightPx: VIEWPORT_HEIGHT_PX,
  paddingPx: DIAGRAM_PADDING_PX,
  roomWidthMm: DEFAULTS.roomWidthMm,
  roomLengthMm: DEFAULTS.roomLengthMm,
  bedFootprintWidthMm: footprint.widthMm,
  bedFootprintLengthMm: footprint.lengthMm,
  orientation: DEFAULTS.orientation,
  sideClearanceMm: DEFAULTS.sideClearanceMm,
  footClearanceMm: DEFAULTS.footClearanceMm,
  nightstandWidthsMm,
  nightstandDepthMm: DEFAULTS.nightstandCount > 0 ? DEFAULTS.nightstandDepthMm : 0,
});

const diagramSummary = `${DEFAULTS.roomWidthMm} by ${DEFAULTS.roomLengthMm} mm room with ${preset.label}, ${DEFAULTS.orientation} orientation, ${DEFAULTS.sideClearanceMm} mm selected side target, and ${DEFAULTS.nightstandCount} bedside tables.`;
---

<div class="bedroom-fitcheck" data-bedroom-fitcheck data-diagram-id={DIAGRAM_ID}>
  <form class="bedroom-fitcheck__form" data-bedroom-fitcheck-form novalidate>
    <div class="field">
      <label for="room-width">Room inside width</label>
      <input
        type="text"
        inputmode="decimal"
        id="room-width"
        name="roomWidthMm"
        min="1"
        step="1"
        value={`${DEFAULTS.roomWidthMm} mm`}
        aria-describedby="room-width-error"
      />
      <span class="field__error" id="room-width-error" role="alert"></span>
    </div>

    <div class="field">
      <label for="room-length">Room inside length</label>
      <input
        type="text"
        inputmode="decimal"
        id="room-length"
        name="roomLengthMm"
        min="1"
        step="1"
        value={`${DEFAULTS.roomLengthMm} mm`}
        aria-describedby="room-length-error"
      />
      <span class="field__error" id="room-length-error" role="alert"></span>
    </div>

    <div class="field">
      <label for="bed-preset">Bed and frame model</label>
      <select id="bed-preset" name="bedPreset">
        {BEDROOM_FIT_PRESETS.map((bedPreset) => (
          <option value={bedPreset.key} selected={bedPreset.key === DEFAULTS.bedPreset}>
            {bedPreset.label}
          </option>
        ))}
      </select>
      <p class="field__note">
        Enter your actual mattress size or choose a market-specific reference. Named frame examples
        use measured models; no generic frame overhang is silently applied.
      </p>
    </div>

    <div class="field-grid" data-custom-bed-fields>
      <div class="field">
        <label for="custom-bed-width">Custom mattress width (editable example)</label>
        <input
          type="text"
          inputmode="decimal"
          id="custom-bed-width"
          name="customBedWidthMm"
          value={`${DEFAULTS.customMattressWidthMm} mm`}
          aria-describedby="custom-bed-width-error"
        />
        <span class="field__error" id="custom-bed-width-error" role="alert"></span>
      </div>
      <div class="field">
        <label for="custom-bed-length">Custom mattress length (editable example)</label>
        <input
          type="text"
          inputmode="decimal"
          id="custom-bed-length"
          name="customBedLengthMm"
          value={`${DEFAULTS.customMattressLengthMm} mm`}
          aria-describedby="custom-bed-length-error"
        />
        <span class="field__error" id="custom-bed-length-error" role="alert"></span>
      </div>
    </div>

    <div class="field">
      <label for="orientation">Bed orientation</label>
      <select id="orientation" name="orientation">
        <option value="portrait" selected>
          Headboard against a short wall
        </option>
        <option value="landscape">Headboard against a long wall</option>
      </select>
    </div>

    <details class="bedroom-fitcheck__advanced">
      <summary>More assumptions</summary>

      <div class="field">
        <label for="side-clearance">Selected side-clearance target</label>
        <input
          type="text"
          inputmode="decimal"
          id="side-clearance"
          name="sideClearanceMm"
          min="0"
          step="1"
          value={DEFAULTS.sideClearanceMm}
          aria-describedby="side-clearance-error"
        />
        <span class="field__error" id="side-clearance-error" role="alert"></span>
      </div>

      <div class="field">
        <label for="foot-clearance">Selected foot-clearance target (assumption)</label>
        <input
          type="text"
          inputmode="decimal"
          id="foot-clearance"
          name="footClearanceMm"
          min="0"
          step="1"
          value={DEFAULTS.footClearanceMm}
          aria-describedby="foot-clearance-error"
        />
        <span class="field__error" id="foot-clearance-error" role="alert"></span>
      </div>

      <div class="field">
        <label for="nightstand-count">Nightstands</label>
        <select id="nightstand-count" name="nightstandCount">
          <option value="0" selected>
            None
          </option>
          <option value="1">1</option>
          <option value="2">2</option>
        </select>
      </div>

      <div class="field">
        <label for="nightstand-width">Measured nightstand width each</label>
        <input
          type="text"
          inputmode="decimal"
          id="nightstand-width"
          name="nightstandWidthMm"
          min="1"
          step="1"
          value={DEFAULTS.nightstandWidthMm}
          aria-describedby="nightstand-width-error"
        />
        <span class="field__error" id="nightstand-width-error" role="alert"></span>
      </div>

      <div class="field">
        <label for="nightstand-depth">Measured nightstand depth each</label>
        <input
          type="text"
          inputmode="decimal"
          id="nightstand-depth"
          name="nightstandDepthMm"
          min="1"
          step="1"
          value={DEFAULTS.nightstandDepthMm}
          aria-describedby="nightstand-depth-error"
        />
        <span class="field__error" id="nightstand-depth-error" role="alert"></span>
      </div>

      <fieldset class="interaction-checks">
        <legend>Optional furniture collision checks</legend>
        <label class="interaction-checks__toggle">
          <input type="checkbox" id="check-wardrobe-door" name="checkWardrobeDoor" />
          Check a hinged wardrobe-door swing
        </label>
        <div data-wardrobe-fields hidden>
          <div class="field">
            <label for="wardrobe-door-width">Measured hinged door leaf width</label>
            <input
              type="text"
              inputmode="decimal"
              id="wardrobe-door-width"
              name="wardrobeDoorWidthMm"
              min="1"
              step="1"
              value={DEFAULTS.wardrobeDoorLeafWidthMm}
              aria-describedby="wardrobe-door-width-error"
            />
            <span class="field__error" id="wardrobe-door-width-error" role="alert"></span>
          </div>
          <div class="field">
            <label for="wardrobe-door-angle">Door opening angle (degrees, 0–90)</label>
            <input
              type="text"
              inputmode="decimal"
              id="wardrobe-door-angle"
              name="wardrobeDoorAngleDegrees"
              min="0"
              max="90"
              step="1"
              value={DEFAULTS.wardrobeDoorAngleDegrees}
              aria-describedby="wardrobe-door-angle-error"
            />
            <span class="field__error" id="wardrobe-door-angle-error" role="alert"></span>
          </div>
          <div class="field">
            <label for="wardrobe-obstacle-gap">
              Measured gap from wardrobe face to bed/obstacle
            </label>
            <input
              type="text"
              inputmode="decimal"
              id="wardrobe-obstacle-gap"
              name="wardrobeObstacleGapMm"
              min="0"
              step="1"
              aria-describedby="wardrobe-obstacle-gap-error"
            />
            <span class="field__error" id="wardrobe-obstacle-gap-error" role="alert"></span>
          </div>
        </div>

        <label class="interaction-checks__toggle">
          <input type="checkbox" id="check-dresser-drawer" name="checkDresserDrawer" />
          Check a dresser drawer extension
        </label>
        <div data-dresser-fields hidden>
          <div class="field">
            <label for="dresser-drawer-pullout">Measured drawer extension</label>
            <input
              type="text"
              inputmode="decimal"
              id="dresser-drawer-pullout"
              name="dresserDrawerPullOutMm"
              min="1"
              step="1"
              value={DEFAULTS.dresserDrawerPullOutMm}
              aria-describedby="dresser-drawer-pullout-error"
            />
            <span class="field__error" id="dresser-drawer-pullout-error" role="alert"></span>
          </div>
          <div class="field">
            <label for="dresser-obstacle-gap">
              Measured gap from dresser front to bed/obstacle
            </label>
            <input
              type="text"
              inputmode="decimal"
              id="dresser-obstacle-gap"
              name="dresserObstacleGapMm"
              min="0"
              step="1"
              aria-describedby="dresser-obstacle-gap-error"
            />
            <span class="field__error" id="dresser-obstacle-gap-error" role="alert"></span>
          </div>
        </div>
        <p class="field__note">
          These checks test door/drawer collision envelopes only. They do not add a standing or
          walking allowance and are not drawn on the room diagram.
        </p>
      </fieldset>
      <p class="field__note">
        Enter dimensions as mm, cm, m, inches or feet (for example, 60 cm or 24 in). Product presets
        are market-specific examples; custom dimensions work globally.
      </p>
    </details>

    <UnitToggle />
  </form>

  <div class="bedroom-fitcheck__result">
    <FitSummary id="bedroom-fitcheck-summary" state={result.state} rows={rows} />

    <ScaleDiagram
      id={DIAGRAM_ID}
      widthPx={VIEWPORT_WIDTH_PX}
      heightPx={VIEWPORT_HEIGHT_PX}
      summary={diagramSummary}
    >
      <Fragment set:html={diagramMarkup} />
    </ScaleDiagram>

    <DimensionTable
      id="bedroom-fitcheck-table"
      rows={rows}
      caption="Room dimensions and selected furniture collision checks: required, selected, available and margin"
    />

    <AssumptionList id="bedroom-fitcheck-assumptions" assumptions={result.assumptions} />
  </div>
</div>

<script>
  import '../../scripts/bedroom-fitcheck';
</script>

<style>
  .bedroom-fitcheck {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 60rem) {
    .bedroom-fitcheck {
      grid-template-columns: 18rem 1fr;
      align-items: start;
    }
  }

  .bedroom-fitcheck__form {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-raised);
  }

  .field {
    display: grid;
    gap: var(--space-1);
  }

  .field label {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .field input,
  .field select {
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text-primary);
    font-size: var(--fs-base);
  }

  .field__error {
    font-size: var(--fs-sm);
    color: var(--color-state-no-fit-fg);
    min-height: 1.2em;
  }

  .field__note {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--fs-xs);
    line-height: 1.4;
  }

  .bedroom-fitcheck__advanced {
    display: grid;
    gap: var(--space-4);
  }

  .bedroom-fitcheck__advanced summary {
    cursor: pointer;
    font-weight: 600;
    font-size: var(--fs-sm);
    color: var(--color-text-primary);
  }

  .interaction-checks {
    display: grid;
    gap: var(--space-3);
    min-width: 0;
    margin: 0;
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .interaction-checks legend {
    padding-inline: var(--space-1);
    font-size: var(--fs-sm);
    font-weight: 700;
  }

  .interaction-checks__toggle {
    display: flex;
    align-items: start;
    gap: var(--space-2);
    color: var(--color-text-primary);
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .interaction-checks [data-wardrobe-fields][hidden],
  .interaction-checks [data-dresser-fields][hidden] {
    display: none;
  }

  .bedroom-fitcheck__result {
    display: grid;
    gap: var(--space-5);
  }
</style>
