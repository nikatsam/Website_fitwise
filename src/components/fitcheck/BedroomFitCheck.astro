---
import FitSummary from '../fit/FitSummary.astro';
import DimensionTable from '../fit/DimensionTable.astro';
import AssumptionList from '../fit/AssumptionList.astro';
import UnitToggle from '../fit/UnitToggle.astro';
import ScaleDiagram from '../diagram/ScaleDiagram.astro';
import { evaluateFit, toDimensionDisplayRows } from '../../lib/fit';
import { buildBedRoomChecks, applyOrientation, computeBedFootprint } from '../../lib/geometry';
import { renderBedroomDiagramMarkup } from '../../lib/diagram';

/**
 * Bed size presets are widely-known nominal/typical market sizes (not a
 * specific sourced product), explicitly labelled as such in the assumptions
 * text below — consistent with how the workspace FitCheck labels its
 * diagonal-derived monitor width as an approximation (see T012 worklog).
 */
const BED_PRESETS = {
  'uk-double': { label: 'UK Double', market: 'UK', widthMm: 1350, lengthMm: 1900 },
  'uk-king': { label: 'UK King', market: 'UK', widthMm: 1500, lengthMm: 2000 },
  'us-queen': { label: 'US Queen', market: 'US', widthMm: 1530, lengthMm: 2030 },
  'us-king': { label: 'US King', market: 'US', widthMm: 1930, lengthMm: 2030 },
} as const;

type BedPresetKey = keyof typeof BED_PRESETS;

const DEFAULTS = {
  roomWidthMm: 3000,
  roomLengthMm: 3600,
  bedPreset: 'uk-king' as BedPresetKey,
  orientation: 'portrait' as const,
  frameAllowanceMm: 50,
  sideClearanceMm: 600,
  footClearanceMm: 600,
};

const DIAGRAM_ID = 'bedroom-diagram';
const VIEWPORT_WIDTH_PX = 640;
const VIEWPORT_HEIGHT_PX = 480;
const DIAGRAM_PADDING_PX = 60;

const preset = BED_PRESETS[DEFAULTS.bedPreset];
const frameAllowance = {
  left: DEFAULTS.frameAllowanceMm,
  right: DEFAULTS.frameAllowanceMm,
  head: DEFAULTS.frameAllowanceMm,
  foot: DEFAULTS.frameAllowanceMm,
};

const checks = buildBedRoomChecks({
  mattressWidthMm: preset.widthMm,
  mattressLengthMm: preset.lengthMm,
  frameAllowanceMm: frameAllowance,
  orientation: DEFAULTS.orientation,
  sideClearanceRecommendedMm: DEFAULTS.sideClearanceMm,
  footClearanceRecommendedMm: DEFAULTS.footClearanceMm,
  roomWidthMm: DEFAULTS.roomWidthMm,
  roomLengthMm: DEFAULTS.roomLengthMm,
});

const assumptions = [
  `Bed size: ${preset.label} (${preset.market} market) — a typical nominal mattress size, not a specific product. Actual products vary slightly.`,
  `Frame allowance: ${DEFAULTS.frameAllowanceMm} mm on every side (frame overhang beyond the mattress).`,
  `Recommended clearance: ${DEFAULTS.sideClearanceMm} mm each side, ${DEFAULTS.footClearanceMm} mm at the foot of the bed. Adjust to taste.`,
];

const result = evaluateFit(checks, assumptions);
const rows = toDimensionDisplayRows(checks, result);
const primaryRow = rows.find((r) => r.dimension === 'room_width') ?? rows[0]!;

const footprint = computeBedFootprint(preset.widthMm, preset.lengthMm, frameAllowance);
const oriented = applyOrientation(footprint, DEFAULTS.orientation);

const diagramMarkup = renderBedroomDiagramMarkup({
  diagramId: DIAGRAM_ID,
  viewportWidthPx: VIEWPORT_WIDTH_PX,
  viewportHeightPx: VIEWPORT_HEIGHT_PX,
  paddingPx: DIAGRAM_PADDING_PX,
  roomWidthMm: DEFAULTS.roomWidthMm,
  roomLengthMm: DEFAULTS.roomLengthMm,
  bedRoomWidthMm: oriented.roomWidthRequiredMm,
  bedRoomLengthMm: oriented.roomLengthRequiredMm,
  sideClearanceMm: DEFAULTS.sideClearanceMm,
  footClearanceMm: DEFAULTS.footClearanceMm,
  nightstandWidthsMm: [],
});

const diagramSummary = `${DEFAULTS.roomWidthMm} by ${DEFAULTS.roomLengthMm} mm room with a ${preset.label} bed (${preset.widthMm} by ${preset.lengthMm} mm mattress), ${DEFAULTS.sideClearanceMm} mm recommended side clearance, ${DEFAULTS.footClearanceMm} mm at the foot.`;
---

<div class="bedroom-fitcheck" data-bedroom-fitcheck data-diagram-id={DIAGRAM_ID}>
  <form class="bedroom-fitcheck__form" data-bedroom-fitcheck-form novalidate>
    <div class="field">
      <label for="room-width">Room width (mm)</label>
      <input
        type="number"
        id="room-width"
        name="roomWidthMm"
        min="1"
        step="1"
        value={DEFAULTS.roomWidthMm}
        aria-describedby="room-width-error"
      />
      <span class="field__error" id="room-width-error" role="alert"></span>
    </div>

    <div class="field">
      <label for="room-length">Room length (mm)</label>
      <input
        type="number"
        id="room-length"
        name="roomLengthMm"
        min="1"
        step="1"
        value={DEFAULTS.roomLengthMm}
        aria-describedby="room-length-error"
      />
      <span class="field__error" id="room-length-error" role="alert"></span>
    </div>

    <div class="field">
      <label for="bed-preset">Bed size</label>
      <select id="bed-preset" name="bedPreset">
        {Object.entries(BED_PRESETS).map(([key, value]) => (
          <option value={key} selected={key === DEFAULTS.bedPreset}>
            {value.label} ({value.market})
          </option>
        ))}
      </select>
    </div>

    <div class="field">
      <label for="orientation">Bed orientation</label>
      <select id="orientation" name="orientation">
        <option value="portrait" selected>
          Headboard against a short wall
        </option>
        <option value="landscape">Headboard against a long wall</option>
      </select>
    </div>

    <details class="bedroom-fitcheck__advanced">
      <summary>More assumptions</summary>

      <div class="field">
        <label for="frame-allowance">Frame allowance per side (mm)</label>
        <input
          type="number"
          id="frame-allowance"
          name="frameAllowanceMm"
          min="0"
          step="1"
          value={DEFAULTS.frameAllowanceMm}
          aria-describedby="frame-allowance-error"
        />
        <span class="field__error" id="frame-allowance-error" role="alert"></span>
      </div>

      <div class="field">
        <label for="side-clearance">Recommended side clearance (mm)</label>
        <input
          type="number"
          id="side-clearance"
          name="sideClearanceMm"
          min="0"
          step="1"
          value={DEFAULTS.sideClearanceMm}
          aria-describedby="side-clearance-error"
        />
        <span class="field__error" id="side-clearance-error" role="alert"></span>
      </div>

      <div class="field">
        <label for="foot-clearance">Recommended foot clearance (mm)</label>
        <input
          type="number"
          id="foot-clearance"
          name="footClearanceMm"
          min="0"
          step="1"
          value={DEFAULTS.footClearanceMm}
          aria-describedby="foot-clearance-error"
        />
        <span class="field__error" id="foot-clearance-error" role="alert"></span>
      </div>

      <div class="field">
        <label for="nightstand-count">Nightstands</label>
        <select id="nightstand-count" name="nightstandCount">
          <option value="0" selected>
            None
          </option>
          <option value="1">1</option>
          <option value="2">2</option>
        </select>
      </div>

      <div class="field">
        <label for="nightstand-width">Nightstand width each (mm)</label>
        <input
          type="number"
          id="nightstand-width"
          name="nightstandWidthMm"
          min="1"
          step="1"
          value="400"
          aria-describedby="nightstand-width-error"
        />
        <span class="field__error" id="nightstand-width-error" role="alert"></span>
      </div>
    </details>

    <UnitToggle />
  </form>

  <div class="bedroom-fitcheck__result">
    <FitSummary id="bedroom-fitcheck-summary" state={result.state} primary={primaryRow} />

    <ScaleDiagram
      id={DIAGRAM_ID}
      widthPx={VIEWPORT_WIDTH_PX}
      heightPx={VIEWPORT_HEIGHT_PX}
      summary={diagramSummary}
    >
      <Fragment set:html={diagramMarkup} />
    </ScaleDiagram>

    <DimensionTable
      id="bedroom-fitcheck-table"
      rows={rows}
      caption="Room width/length breakdown: required, recommended, available and margin"
    />

    <AssumptionList id="bedroom-fitcheck-assumptions" assumptions={result.assumptions} />
  </div>
</div>

<script>
  import '../../scripts/bedroom-fitcheck';
</script>

<style>
  .bedroom-fitcheck {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 60rem) {
    .bedroom-fitcheck {
      grid-template-columns: 18rem 1fr;
      align-items: start;
    }
  }

  .bedroom-fitcheck__form {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-raised);
  }

  .field {
    display: grid;
    gap: var(--space-1);
  }

  .field label {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .field input,
  .field select {
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text-primary);
    font-size: var(--fs-base);
  }

  .field__error {
    font-size: var(--fs-sm);
    color: var(--color-state-no-fit-fg);
    min-height: 1.2em;
  }

  .bedroom-fitcheck__advanced {
    display: grid;
    gap: var(--space-4);
  }

  .bedroom-fitcheck__advanced summary {
    cursor: pointer;
    font-weight: 600;
    font-size: var(--fs-sm);
    color: var(--color-text-primary);
  }

  .bedroom-fitcheck__result {
    display: grid;
    gap: var(--space-5);
  }
</style>
