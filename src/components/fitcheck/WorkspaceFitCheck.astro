---
import FitSummary from '../fit/FitSummary.astro';
import CalculatorStep from '../fit/CalculatorStep.astro';
import ExampleDataNotice from '../fit/ExampleDataNotice.astro';
import MeasurementFieldHelp from '../fit/MeasurementFieldHelp.astro';
import DimensionTable from '../fit/DimensionTable.astro';
import AssumptionList from '../fit/AssumptionList.astro';
import UnitToggle from '../fit/UnitToggle.astro';
import ScaleDiagram from '../diagram/ScaleDiagram.astro';
import { evaluateFit, toDimensionDisplayRows } from '../../lib/fit';
import {
  buildWorkspaceConfigurationCheck,
  buildWorkspaceDepthCheck,
  deriveScreenDimensions,
  MONITOR_ASPECT_RATIOS,
} from '../../lib/geometry';
import { renderWorkspaceDiagramMarkup } from '../../lib/diagram';
import { formatMeasurement } from '../../lib/units';
import { localeFromPath } from '../../i18n/locale';
import { pathForLocale } from '../../i18n/locale';
import { translateWorkspaceBedroomText as t } from '../../i18n/workspace-bedroom-text';
const locale = localeFromPath(Astro.url.pathname);

// Default, SSR-rendered scenario: this is the complete static answer a
// visitor gets with JavaScript disabled (tasks/T012 acceptance criterion 1).
// The initial stand depth is an editable example. Rear cable and keyboard
// zones default to zero and are explicitly excluded until the visitor sets them.
const DEFAULTS = {
  deskWidthMm: 1400,
  deskDepthMm: 700,
  monitorCount: 2,
  monitorDiagonalIn: 27,
  monitorAspectRatio: '16:9' as keyof typeof MONITOR_ASPECT_RATIOS,
  monitorDepthMm: 200,
  rearCableClearanceMm: 0,
  keyboardZoneMm: 0,
  gapMm: 20,
  sideMarginMm: 38,
};

const DIAGRAM_ID = 'workspace-diagram';
const VIEWPORT_WIDTH_PX = 640;
const VIEWPORT_HEIGHT_PX = 360;
const DIAGRAM_PADDING_PX = 60;

const derivedScreen = deriveScreenDimensions(
  DEFAULTS.monitorDiagonalIn,
  MONITOR_ASPECT_RATIOS[DEFAULTS.monitorAspectRatio],
);
const monitorWidthMm = Math.round(derivedScreen.screenWidthMm.valueMm);

const { check: widthCheck } = buildWorkspaceConfigurationCheck({
  widthsMm: Array.from({ length: DEFAULTS.monitorCount }, () => monitorWidthMm),
  gapMm: DEFAULTS.gapMm,
  sideMarginRecommendedMm: DEFAULTS.sideMarginMm,
  deskWidthMm: DEFAULTS.deskWidthMm,
});
const depthCheck = buildWorkspaceDepthCheck({
  monitorStandDepthMm: DEFAULTS.monitorDepthMm,
  rearClearanceMm: DEFAULTS.rearCableClearanceMm,
  keyboardZoneMm: DEFAULTS.keyboardZoneMm,
  deskDepthMm: DEFAULTS.deskDepthMm,
});
const checks = [widthCheck, depthCheck];

const assumptions = [
  t(
    locale,
    `Monitor width: approximate screen-only width derived from a ${DEFAULTS.monitorDiagonalIn}" ${DEFAULTS.monitorAspectRatio} diagonal and rounded to the nearest millimetre; actual device is typically wider due to bezel. Enter an exact overall width below to override.`,
  ),
  t(
    locale,
    `Monitor stand/base depth: ${formatMeasurement(DEFAULTS.monitorDepthMm)} initial example; replace it with the actual model's sourced depth.`,
  ),
  t(
    locale,
    `Rear cable/vent allowance: ${formatMeasurement(DEFAULTS.rearCableClearanceMm)}. Zero means no rear allowance was included.`,
  ),
  t(
    locale,
    `Keyboard/mouse surface zone: ${formatMeasurement(DEFAULTS.keyboardZoneMm)}, selected by the user. Zero means no front working zone was included.`,
  ),
  t(
    locale,
    'Eye-to-screen viewing distance is separate from the desktop-depth envelope and is not calculated as a desk surface measurement.',
  ),
  t(locale, `Gap between monitors: ${formatMeasurement(DEFAULTS.gapMm)}.`),
];

const result = evaluateFit(checks, assumptions);
const rows = toDimensionDisplayRows(checks, result);

const diagramMarkup = renderWorkspaceDiagramMarkup({
  diagramId: DIAGRAM_ID,
  viewportWidthPx: VIEWPORT_WIDTH_PX,
  viewportHeightPx: VIEWPORT_HEIGHT_PX,
  paddingPx: DIAGRAM_PADDING_PX,
  deskWidthMm: DEFAULTS.deskWidthMm,
  deskDepthMm: DEFAULTS.deskDepthMm,
  monitorWidthMm,
  monitorDepthMm: DEFAULTS.monitorDepthMm,
  monitorCount: DEFAULTS.monitorCount,
  gapMm: DEFAULTS.gapMm,
  sideMarginMm: DEFAULTS.sideMarginMm,
  locale,
});

const diagramSummary = t(
  locale,
  `${formatMeasurement(DEFAULTS.deskWidthMm)} by ${formatMeasurement(DEFAULTS.deskDepthMm)} desk with ${DEFAULTS.monitorCount} monitors (${formatMeasurement(monitorWidthMm)} screen width each), ${formatMeasurement(DEFAULTS.gapMm)} gap. Stand depth and user-selected cable/keyboard zones are checked separately in the results table.`,
);
---

<div
  class="workspace-fitcheck calculator-split"
  data-workspace-fitcheck
  data-fit-result-scope
  data-diagram-id={DIAGRAM_ID}
>
  <form
    class="workspace-fitcheck__form"
    data-workspace-fitcheck-form
    data-core-progressive-form
    novalidate
  >
    <ExampleDataNotice
      note={t(locale, 'Replace the starter equipment and desk values with your own measurements.')}
    />
    <CalculatorStep
      step={1}
      title={t(locale, 'What are you fitting?')}
      description={t(
        locale,
        'Describe the monitor setup whose combined footprint will sit on the desk.',
      )}
    >
      <div class="field">
        <label for="monitor-count">{t(locale, 'Number of monitors')}</label>
        <select id="monitor-count" name="monitorCount">
          {[1, 2, 3, 4].map((count) => (
            <option value={count} selected={count === DEFAULTS.monitorCount}>
              {count}
            </option>
          ))}
        </select>
      </div>

      <div class="field">
        <label for="monitor-diagonal">{t(locale, 'Screen diagonal (inches)')}</label>
        <select
          id="monitor-diagonal"
          name="monitorDiagonalIn"
          aria-describedby="monitor-diagonal-help"
        >
          <option value="24">24"</option>
          <option value="27" selected>
            27"
          </option>
          <option value="32">32"</option>
          <option value="34">34"</option>
          <option value="49">49"</option>
        </select>
        <MeasurementFieldHelp
          calculator="workspace"
          fieldId="monitor-diagonal"
          id="monitor-diagonal-help"
        />
      </div>

      <div class="field">
        <label for="monitor-aspect-ratio">{t(locale, 'Screen aspect ratio')}</label>
        <select
          id="monitor-aspect-ratio"
          name="monitorAspectRatio"
          aria-describedby="monitor-aspect-ratio-help"
        >
          {Object.keys(MONITOR_ASPECT_RATIOS).map((ratio) => (
            <option value={ratio} selected={ratio === DEFAULTS.monitorAspectRatio}>
              {ratio}
            </option>
          ))}
        </select>
        <MeasurementFieldHelp
          calculator="workspace"
          fieldId="monitor-aspect-ratio"
          id="monitor-aspect-ratio-help"
        />
      </div>
    </CalculatorStep>

    <CalculatorStep
      step={2}
      title={t(locale, 'Where does it need to fit?')}
      description={t(locale, 'Enter the usable desktop width and depth.')}
    >
      <div class="field">
        <label for="desk-width">{t(locale, 'Desk width')}</label>
        <input
          type="text"
          inputmode="text"
          id="desk-width"
          name="deskWidthMm"
          value={`${DEFAULTS.deskWidthMm} mm`}
          aria-describedby="desk-width-error desk-width-help"
        />
        <span class="field__error" id="desk-width-error" role="alert"></span>
        <MeasurementFieldHelp calculator="workspace" fieldId="desk-width" id="desk-width-help" />
      </div>

      <div class="field">
        <label for="desk-depth">{t(locale, 'Desk depth')}</label>
        <input
          type="text"
          inputmode="text"
          id="desk-depth"
          name="deskDepthMm"
          value={`${DEFAULTS.deskDepthMm} mm`}
          aria-describedby="desk-depth-error desk-depth-help"
        />
        <span class="field__error" id="desk-depth-error" role="alert"></span>
        <MeasurementFieldHelp calculator="workspace" fieldId="desk-depth" id="desk-depth-help" />
      </div>
      <p class="field__note">
        {t(
          locale,
          'Lengths accept mm, cm, m, in, ft, or feet plus inches. Bare numbers default to mm.',
        )}
      </p>
    </CalculatorStep>

    <details class="workspace-fitcheck__advanced">
      <summary>{t(locale, 'Advanced options · Optional')}</summary>
      <CalculatorStep
        step={3}
        title={t(locale, 'Advanced options')}
        description={t(
          locale,
          'Measure the exact monitor setup, reserve workspace, or set monitor spacing and clearance targets.',
        )}
      >
        <section
          class="advanced-options__group"
          data-advanced-options-group
          aria-labelledby="workspace-monitor-footprint-heading"
        >
          <h3 id="workspace-monitor-footprint-heading">
            {t(locale, 'Measure the actual monitor footprint')}
          </h3>
          <div class="field">
            <label for="monitor-depth">
              {t(locale, 'Monitor stand/base depth (editable example)')}
            </label>
            <input
              type="text"
              inputmode="text"
              id="monitor-depth"
              name="monitorStandDepthMm"
              value={`${DEFAULTS.monitorDepthMm} mm`}
              aria-describedby="monitor-depth-error monitor-depth-help"
            />
            <span class="field__error" id="monitor-depth-error" role="alert"></span>
            <MeasurementFieldHelp
              calculator="workspace"
              fieldId="monitor-depth"
              id="monitor-depth-help"
            >
              <p>
                See the{' '}
                <a href={pathForLocale('/workspace/desk-depth-for-monitor/', locale)}>
                  {t(locale, 'Samsung M7 stand-depth example')}
                </a>
                .
              </p>
            </MeasurementFieldHelp>
          </div>
          <div class="field">
            <label for="monitor-width-override">
              {t(locale, 'Exact overall monitor width including bezel')}
            </label>
            <input
              type="text"
              inputmode="text"
              id="monitor-width-override"
              name="monitorWidthOverrideMm"
              data-step-optional
              placeholder={t(locale, 'Auto from size')}
              aria-describedby="monitor-width-override-error monitor-width-override-help"
            />
            <span class="field__error" id="monitor-width-override-error" role="alert"></span>
            <MeasurementFieldHelp
              calculator="workspace"
              fieldId="monitor-width-override"
              id="monitor-width-override-help"
            />
          </div>
        </section>

        <section
          class="advanced-options__group"
          data-advanced-options-group
          aria-labelledby="workspace-working-space-heading"
        >
          <h3 id="workspace-working-space-heading">
            {t(locale, 'Reserve cable and keyboard space')}
          </h3>
          <div class="field">
            <label for="rear-cable-clearance">{t(locale, 'Rear cable/vent allowance')}</label>
            <input
              type="text"
              inputmode="text"
              id="rear-cable-clearance"
              name="rearCableClearanceMm"
              value={`${DEFAULTS.rearCableClearanceMm} mm`}
              aria-describedby="rear-cable-clearance-error rear-cable-clearance-help"
            />
            <span class="field__error" id="rear-cable-clearance-error" role="alert"></span>
            <MeasurementFieldHelp
              calculator="workspace"
              fieldId="rear-cable-clearance"
              id="rear-cable-clearance-help"
            />
          </div>
          <div class="field">
            <label for="keyboard-zone">
              {t(locale, 'Keyboard/mouse surface zone (user-selected)')}
            </label>
            <input
              type="text"
              inputmode="text"
              id="keyboard-zone"
              name="keyboardZoneMm"
              value={`${DEFAULTS.keyboardZoneMm} mm`}
              aria-describedby="keyboard-zone-error keyboard-zone-help"
            />
            <span class="field__error" id="keyboard-zone-error" role="alert"></span>
            <MeasurementFieldHelp
              calculator="workspace"
              fieldId="keyboard-zone"
              id="keyboard-zone-help"
            />
            <p class="field__note">
              {t(
                locale,
                'Viewing distance is not added to desk depth. Enter the actual keyboard/cable areas you want to reserve; zero means they are excluded.',
              )}
            </p>
          </div>
        </section>

        <section
          class="advanced-options__group"
          data-advanced-options-group
          aria-labelledby="workspace-monitor-spacing-heading"
        >
          <h3 id="workspace-monitor-spacing-heading">
            {t(locale, 'Set monitor spacing and side clearance')}
          </h3>
          <div class="field">
            <label for="monitor-gap">{t(locale, 'Gap between monitors')}</label>
            <input
              type="text"
              inputmode="text"
              id="monitor-gap"
              name="gapMm"
              value={`${DEFAULTS.gapMm} mm`}
              aria-describedby="monitor-gap-error monitor-gap-help"
            />
            <span class="field__error" id="monitor-gap-error" role="alert"></span>
            <MeasurementFieldHelp
              calculator="workspace"
              fieldId="monitor-gap"
              id="monitor-gap-help"
            />
          </div>

          <div class="field">
            <label for="side-margin">{t(locale, 'Recommended side clearance target')}</label>
            <input
              type="text"
              inputmode="text"
              id="side-margin"
              name="sideMarginMm"
              value={`${DEFAULTS.sideMarginMm} mm`}
              aria-describedby="side-margin-error side-margin-help"
            />
            <span class="field__error" id="side-margin-error" role="alert"></span>
            <MeasurementFieldHelp
              calculator="workspace"
              fieldId="side-margin"
              id="side-margin-help"
            />
          </div>
        </section>
      </CalculatorStep>
    </details>

    <UnitToggle />
  </form>

  <div class="workspace-fitcheck__result calculator-split__result">
    <FitSummary
      id="workspace-fitcheck-summary"
      resultId="workspace-fitcheck-table"
      state={result.state}
      rows={rows}
      resultOrigin="example"
    />

    <ScaleDiagram
      id={DIAGRAM_ID}
      widthPx={VIEWPORT_WIDTH_PX}
      heightPx={VIEWPORT_HEIGHT_PX}
      summary={diagramSummary}
    >
      <Fragment set:html={diagramMarkup} />
    </ScaleDiagram>

    <DimensionTable
      id="workspace-fitcheck-table"
      rows={rows}
      caption={t(
        locale,
        'Desk width and depth envelopes: required, selected, available and margin',
      )}
    />

    <AssumptionList id="workspace-fitcheck-assumptions" assumptions={result.assumptions} />
  </div>
</div>

<script>
  import '../../scripts/workspace-fitcheck';
</script>

<style>
  .workspace-fitcheck {
    display: grid;
    gap: var(--space-6);
  }

  .workspace-fitcheck__form {
    display: grid;
    gap: var(--space-4);
    min-width: 0;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-raised);
  }

  .field {
    display: grid;
    gap: var(--space-1);
  }

  .field label {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .field input,
  .field select {
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text-primary);
    font-size: var(--fs-base);
  }

  .field__error {
    font-size: var(--fs-sm);
    color: var(--color-state-no-fit-fg);
    min-height: 1.2em;
  }

  .field__note {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--fs-xs);
    line-height: 1.4;
  }

  .workspace-fitcheck__advanced {
    display: grid;
    gap: var(--space-4);
  }

  .workspace-fitcheck__advanced summary {
    cursor: pointer;
    font-weight: 600;
    font-size: var(--fs-sm);
    color: var(--color-text-primary);
  }

  .workspace-fitcheck__result {
    display: grid;
    gap: var(--space-5);
    min-width: 0;
  }

  @media (max-width: 61.999rem) {
    .workspace-fitcheck {
      padding-bottom: 4.5rem;
    }
  }
</style>
