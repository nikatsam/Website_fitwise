---
import FitSummary from '../fit/FitSummary.astro';
import DimensionTable from '../fit/DimensionTable.astro';
import AssumptionList from '../fit/AssumptionList.astro';
import UnitToggle from '../fit/UnitToggle.astro';
import ScaleDiagram from '../diagram/ScaleDiagram.astro';
import { evaluateFit, toDimensionDisplayRows } from '../../lib/fit';
import {
  buildWorkspaceConfigurationCheck,
  buildWorkspaceDepthCheck,
  deriveScreenDimensions,
  MONITOR_ASPECT_RATIOS,
} from '../../lib/geometry';
import { renderWorkspaceDiagramMarkup } from '../../lib/diagram';
import { formatMeasurement } from '../../lib/units';

// Default, SSR-rendered scenario: this is the complete static answer a
// visitor gets with JavaScript disabled (tasks/T012 acceptance criterion 1).
// The initial stand depth is an editable example. Rear cable and keyboard
// zones default to zero and are explicitly excluded until the visitor sets them.
const DEFAULTS = {
  deskWidthMm: 1400,
  deskDepthMm: 700,
  monitorCount: 2,
  monitorDiagonalIn: 27,
  monitorAspectRatio: '16:9' as keyof typeof MONITOR_ASPECT_RATIOS,
  monitorDepthMm: 200,
  rearCableClearanceMm: 0,
  keyboardZoneMm: 0,
  gapMm: 20,
  sideMarginMm: 38,
};

const DIAGRAM_ID = 'workspace-diagram';
const VIEWPORT_WIDTH_PX = 640;
const VIEWPORT_HEIGHT_PX = 360;
const DIAGRAM_PADDING_PX = 60;

const derivedScreen = deriveScreenDimensions(
  DEFAULTS.monitorDiagonalIn,
  MONITOR_ASPECT_RATIOS[DEFAULTS.monitorAspectRatio],
);
const monitorWidthMm = Math.round(derivedScreen.screenWidthMm.valueMm);

const { check: widthCheck } = buildWorkspaceConfigurationCheck({
  widthsMm: Array.from({ length: DEFAULTS.monitorCount }, () => monitorWidthMm),
  gapMm: DEFAULTS.gapMm,
  sideMarginRecommendedMm: DEFAULTS.sideMarginMm,
  deskWidthMm: DEFAULTS.deskWidthMm,
});
const depthCheck = buildWorkspaceDepthCheck({
  monitorStandDepthMm: DEFAULTS.monitorDepthMm,
  rearClearanceMm: DEFAULTS.rearCableClearanceMm,
  keyboardZoneMm: DEFAULTS.keyboardZoneMm,
  deskDepthMm: DEFAULTS.deskDepthMm,
});
const checks = [widthCheck, depthCheck];

const assumptions = [
  `Monitor width: approximate screen-only width derived from a ${DEFAULTS.monitorDiagonalIn}" ${DEFAULTS.monitorAspectRatio} diagonal and rounded to the nearest millimetre; actual device is typically wider due to bezel. Enter an exact overall width below to override.`,
  `Monitor stand/base depth: ${formatMeasurement(DEFAULTS.monitorDepthMm)} initial example; replace it with the actual model's sourced depth.`,
  `Rear cable/vent allowance: ${formatMeasurement(DEFAULTS.rearCableClearanceMm)}. Zero means no rear allowance was included.`,
  `Keyboard/mouse surface zone: ${formatMeasurement(DEFAULTS.keyboardZoneMm)}, selected by the user. Zero means no front working zone was included.`,
  'Eye-to-screen viewing distance is separate from the desktop-depth envelope and is not calculated as a desk surface measurement.',
  `Gap between monitors: ${formatMeasurement(DEFAULTS.gapMm)}.`,
];

const result = evaluateFit(checks, assumptions);
const rows = toDimensionDisplayRows(checks, result);

const diagramMarkup = renderWorkspaceDiagramMarkup({
  diagramId: DIAGRAM_ID,
  viewportWidthPx: VIEWPORT_WIDTH_PX,
  viewportHeightPx: VIEWPORT_HEIGHT_PX,
  paddingPx: DIAGRAM_PADDING_PX,
  deskWidthMm: DEFAULTS.deskWidthMm,
  deskDepthMm: DEFAULTS.deskDepthMm,
  monitorWidthMm,
  monitorDepthMm: DEFAULTS.monitorDepthMm,
  monitorCount: DEFAULTS.monitorCount,
  gapMm: DEFAULTS.gapMm,
  sideMarginMm: DEFAULTS.sideMarginMm,
});

const diagramSummary = `${formatMeasurement(DEFAULTS.deskWidthMm)} by ${formatMeasurement(DEFAULTS.deskDepthMm)} desk with ${DEFAULTS.monitorCount} monitors (${formatMeasurement(monitorWidthMm)} screen width each), ${formatMeasurement(DEFAULTS.gapMm)} gap. Stand depth and user-selected cable/keyboard zones are checked separately in the results table.`;
---

<div class="workspace-fitcheck" data-workspace-fitcheck data-diagram-id={DIAGRAM_ID}>
  <form class="workspace-fitcheck__form" data-workspace-fitcheck-form novalidate>
    <p class="fit-example-notice" data-fit-example-notice role="note">
      <strong>Example setup.</strong> Starter dimensions are illustrative; change them to your
      measured equipment and desk before relying on the result.
    </p>
    <div class="field">
      <label for="desk-width">Desk width (mm)</label>
      <input
        type="number"
        id="desk-width"
        name="deskWidthMm"
        min="1"
        step="1"
        value={DEFAULTS.deskWidthMm}
        aria-describedby="desk-width-error"
      />
      <span class="field__error" id="desk-width-error" role="alert"></span>
    </div>

    <div class="field">
      <label for="monitor-count">Number of monitors</label>
      <select id="monitor-count" name="monitorCount">
        {[1, 2, 3, 4].map((count) => (
          <option value={count} selected={count === DEFAULTS.monitorCount}>
            {count}
          </option>
        ))}
      </select>
    </div>

    <div class="field">
      <label for="monitor-diagonal">Monitor size</label>
      <select id="monitor-diagonal" name="monitorDiagonalIn">
        <option value="24">24"</option>
        <option value="27" selected>
          27"
        </option>
        <option value="32">32"</option>
        <option value="34">34"</option>
        <option value="49">49"</option>
      </select>
    </div>

    <div class="field">
      <label for="monitor-aspect-ratio">Screen aspect ratio</label>
      <select id="monitor-aspect-ratio" name="monitorAspectRatio">
        {Object.keys(MONITOR_ASPECT_RATIOS).map((ratio) => (
          <option value={ratio} selected={ratio === DEFAULTS.monitorAspectRatio}>
            {ratio}
          </option>
        ))}
      </select>
    </div>

    <details class="workspace-fitcheck__advanced">
      <summary>More assumptions</summary>

      <div class="field">
        <label for="desk-depth">Desk depth (mm)</label>
        <input
          type="number"
          id="desk-depth"
          name="deskDepthMm"
          min="1"
          step="1"
          value={DEFAULTS.deskDepthMm}
          aria-describedby="desk-depth-error"
        />
        <span class="field__error" id="desk-depth-error" role="alert"></span>
      </div>

      <div class="field">
        <label for="monitor-depth">Monitor stand/base depth (mm; editable example)</label>
        <input
          type="number"
          id="monitor-depth"
          name="monitorStandDepthMm"
          min="1"
          step="1"
          value={DEFAULTS.monitorDepthMm}
          aria-describedby="monitor-depth-error"
        />
        <span class="field__error" id="monitor-depth-error" role="alert"></span>
        <p class="field__note">
          The 200 mm default is a FitWise placeholder, not a standard. Replace it with your model's
          measured depth; see the{' '}
          <a href="/workspace/desk-depth-for-monitor/">Samsung M7 stand-depth example</a>.
        </p>
      </div>

      <div class="field">
        <label for="rear-cable-clearance">Rear cable/vent allowance (mm; user-measured)</label>
        <input
          type="number"
          id="rear-cable-clearance"
          name="rearCableClearanceMm"
          min="0"
          step="1"
          value={DEFAULTS.rearCableClearanceMm}
          aria-describedby="rear-cable-clearance-error"
        />
        <span class="field__error" id="rear-cable-clearance-error" role="alert"></span>
      </div>

      <div class="field">
        <label for="keyboard-zone">Keyboard/mouse surface zone (mm; user-selected)</label>
        <input
          type="number"
          id="keyboard-zone"
          name="keyboardZoneMm"
          min="0"
          step="1"
          value={DEFAULTS.keyboardZoneMm}
          aria-describedby="keyboard-zone-error"
        />
        <span class="field__error" id="keyboard-zone-error" role="alert"></span>
        <p class="field__note">
          Viewing distance is not added to desk depth. Enter the actual keyboard/cable areas you
          want to reserve; zero means they are excluded.
        </p>
      </div>

      <div class="field">
        <label for="monitor-width-override">
          Exact overall monitor width incl. bezel (mm, optional)
        </label>
        <input
          type="number"
          id="monitor-width-override"
          name="monitorWidthOverrideMm"
          min="1"
          step="1"
          placeholder="auto from size"
          aria-describedby="monitor-width-override-error"
        />
        <span class="field__error" id="monitor-width-override-error" role="alert"></span>
      </div>

      <div class="field">
        <label for="monitor-gap">Gap between monitors (mm)</label>
        <input
          type="number"
          id="monitor-gap"
          name="gapMm"
          min="0"
          step="1"
          value={DEFAULTS.gapMm}
          aria-describedby="monitor-gap-error"
        />
        <span class="field__error" id="monitor-gap-error" role="alert"></span>
      </div>

      <div class="field">
        <label for="side-margin">Recommended side clearance target (mm)</label>
        <input
          type="number"
          id="side-margin"
          name="sideMarginMm"
          min="0"
          step="1"
          value={DEFAULTS.sideMarginMm}
          aria-describedby="side-margin-error"
        />
        <span class="field__error" id="side-margin-error" role="alert"></span>
      </div>
    </details>

    <UnitToggle />
  </form>

  <div class="workspace-fitcheck__result">
    <FitSummary
      id="workspace-fitcheck-summary"
      resultId="workspace-fitcheck-table"
      state={result.state}
      rows={rows}
    />

    <ScaleDiagram
      id={DIAGRAM_ID}
      widthPx={VIEWPORT_WIDTH_PX}
      heightPx={VIEWPORT_HEIGHT_PX}
      summary={diagramSummary}
    >
      <Fragment set:html={diagramMarkup} />
    </ScaleDiagram>

    <DimensionTable
      id="workspace-fitcheck-table"
      rows={rows}
      caption="Desk width and depth envelopes: required, selected, available and margin"
    />

    <AssumptionList id="workspace-fitcheck-assumptions" assumptions={result.assumptions} />
  </div>
</div>

<script>
  import '../../scripts/workspace-fitcheck';
</script>

<style>
  .workspace-fitcheck {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 60rem) {
    .workspace-fitcheck {
      grid-template-columns: 18rem 1fr;
      align-items: start;
    }
  }

  .workspace-fitcheck__form {
    display: grid;
    gap: var(--space-4);
    min-width: 0;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-raised);
  }

  .fit-example-notice {
    margin: 0;
    padding: var(--space-3);
    border-left: 0.2rem solid var(--color-accent-1);
    background: var(--color-surface);
    font-size: var(--fs-sm);
    line-height: 1.5;
  }

  .field {
    display: grid;
    gap: var(--space-1);
  }

  .field label {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .field input,
  .field select {
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text-primary);
    font-size: var(--fs-base);
  }

  .field__error {
    font-size: var(--fs-sm);
    color: var(--color-state-no-fit-fg);
    min-height: 1.2em;
  }

  .field__note {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--fs-xs);
    line-height: 1.4;
  }

  .workspace-fitcheck__advanced {
    display: grid;
    gap: var(--space-4);
  }

  .workspace-fitcheck__advanced summary {
    cursor: pointer;
    font-weight: 600;
    font-size: var(--fs-sm);
    color: var(--color-text-primary);
  }

  .workspace-fitcheck__result {
    display: grid;
    gap: var(--space-5);
    min-width: 0;
  }

  @media (min-width: 60rem) {
    .workspace-fitcheck__result {
      position: sticky;
      top: calc(var(--header-height, 4rem) + var(--space-4));
    }
  }

  @media (max-width: 59.999rem) {
    .workspace-fitcheck {
      padding-bottom: 4.5rem;
    }
  }
</style>
