---
import {
  LOCALE_META,
  localeFromLanguage,
  localeFromPath,
  pathForLocale,
  SUPPORTED_LOCALES,
  type Locale,
} from '../../i18n/locale';
import { translateRequired, translateTemplate } from '../../i18n/text';

interface Props {
  currentPath: string;
  language?: string;
}

const { currentPath, language } = Astro.props;
const locale: Locale = language ? localeFromLanguage(language) : localeFromPath(currentPath);
const shouldShow = !currentPath.startsWith('/dev/');
const isHome = pathForLocale(currentPath, 'en') === '/';
const options = SUPPORTED_LOCALES.map((code) => ({
  code,
  href: pathForLocale(currentPath, code),
  ...LOCALE_META[code],
}));
const switcherLabel = translateTemplate(locale, 'Site language: {language}', {
  language: LOCALE_META[locale].nativeName,
});
const suggestionHrefs = JSON.stringify(Object.fromEntries(options.map((o) => [o.code, o.href])));
const suggestionNames = JSON.stringify(
  Object.fromEntries(options.map((o) => [o.code, o.nativeName])),
);
---

<div class="language-control" hidden={!shouldShow}>
  <details class="language-menu" data-language-menu>
    <summary class="language-switcher__trigger" aria-label={switcherLabel}>
      <svg
        class="language-switcher__globe"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="9" />
        <path d="M3 12h18M12 3a14 14 0 0 1 0 18m0-18a14 14 0 0 0 0 18" />
      </svg>
      <span class="language-switcher__current">{LOCALE_META[locale].badge}</span>
      <svg
        class="language-switcher__chevron"
        viewBox="0 0 12 12"
        width="12"
        height="12"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        aria-hidden="true"
      >
        <path d="m2 4 4 4 4-4" />
      </svg>
    </summary>
    <nav class="language-switcher__options" aria-label={translateRequired(locale, 'Site language')}>
      {options.map((option) => (
        <a
          href={option.href}
          lang={option.hreflang}
          hreflang={option.hreflang}
          data-language-choice={option.code}
          aria-current={locale === option.code ? 'page' : undefined}
        >
          <span class="language-switcher__name">{option.nativeName}</span>
          <span class="language-switcher__code">{option.badge}</span>
          <small data-saved-language hidden>
            {translateRequired(locale, 'Saved preference')}
          </small>
        </a>
      ))}
    </nav>
  </details>
  {isHome && (
    <aside
      class="language-suggestion"
      data-language-suggestion
      data-current-language={locale}
      data-message={translateRequired(locale, 'Your saved language preference is {language}.')}
      data-continue={translateRequired(locale, 'Continue to {language}')}
      data-language-names={suggestionNames}
      data-language-hrefs={suggestionHrefs}
      hidden
    >
      <span data-suggestion-message></span>
      <a data-suggestion-link></a>
      <button
        type="button"
        data-suggestion-dismiss
        aria-label={translateRequired(locale, 'Dismiss language suggestion')}
      >
        ×
      </button>
    </aside>
  )}
</div>

<script>
  import { isLocale } from '../../i18n/locale';

  const preferenceKey = 'fitwise-language-preference';
  const dismissedKey = 'fitwise-language-suggestion-dismissed';
  const controls = [...document.querySelectorAll<HTMLAnchorElement>('[data-language-choice]')];
  const suggestion = document.querySelector<HTMLElement>('[data-language-suggestion]');
  const menu = document.querySelector<HTMLDetailsElement>('[data-language-menu]');

  const savedPreference = () => {
    try {
      const value = localStorage.getItem(preferenceKey);
      return isLocale(value) ? value : null;
    } catch {
      return null;
    }
  };

  const updatePreferenceIndicator = () => {
    const saved = savedPreference();
    controls.forEach((link) => {
      const marker = link.querySelector<HTMLElement>('[data-saved-language]');
      const isSaved = Boolean(saved && link.dataset.languageChoice === saved);
      if (marker) marker.hidden = !isSaved;
      if (isSaved)
        link.setAttribute(
          'aria-label',
          `${link.querySelector('.language-switcher__name')?.textContent?.trim()} (${marker?.textContent?.trim()})`,
        );
      else link.removeAttribute('aria-label');
    });
  };

  controls.forEach((link) => {
    link.addEventListener('click', () => {
      try {
        localStorage.setItem(preferenceKey, link.dataset.languageChoice ?? 'en');
      } catch {
        // Navigation still works when browser storage is disabled.
      }
    });
  });

  menu?.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !menu.open) return;
    menu.open = false;
    menu.querySelector('summary')?.focus();
  });
  document.addEventListener('pointerdown', (event) => {
    if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) {
      menu.open = false;
    }
  });

  updatePreferenceIndicator();

  if (suggestion) {
    const saved = savedPreference();
    const current = suggestion.dataset.currentLanguage;
    if (saved && saved !== current) {
      const names = JSON.parse(suggestion.dataset.languageNames ?? '{}') as Record<string, string>;
      const hrefs = JSON.parse(suggestion.dataset.languageHrefs ?? '{}') as Record<string, string>;
      const savedLanguageName = names[saved] ?? '';
      const message = suggestion.dataset.message?.replace('{language}', savedLanguageName);
      const continueLabel = suggestion.dataset.continue?.replace('{language}', savedLanguageName);
      const messageNode = suggestion.querySelector<HTMLElement>('[data-suggestion-message]');
      const link = suggestion.querySelector<HTMLAnchorElement>('[data-suggestion-link]');
      const href = hrefs[saved];
      if (messageNode && link && message && continueLabel && href) {
        messageNode.textContent = message;
        link.textContent = continueLabel;
        link.href = href;
        link.dataset.languageChoice = saved;
        suggestion.hidden = false;
        link.addEventListener('click', () => {
          try {
            localStorage.setItem(preferenceKey, saved);
          } catch {
            /* User can still navigate. */
          }
        });
      }
    }

    suggestion
      .querySelector<HTMLButtonElement>('[data-suggestion-dismiss]')
      ?.addEventListener('click', () => {
        suggestion.hidden = true;
        try {
          sessionStorage.setItem(dismissedKey, '1');
        } catch {
          /* Dismissal is optional. */
        }
      });
    try {
      if (sessionStorage.getItem(dismissedKey) === '1') suggestion.hidden = true;
    } catch {
      // The suggestion remains available when session storage is disabled.
    }
  }
</script>

<style>
  .language-control {
    display: grid;
    grid-column: 1;
    grid-row: 1;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    gap: var(--space-2);
    flex: 0 0 auto;
    min-width: 0;
  }

  .language-control[hidden] {
    display: none;
  }

  .language-menu {
    position: relative;
    grid-column: 1;
    grid-row: 1;
    justify-self: start;
  }

  .language-switcher__trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface-raised);
    color: var(--color-text-primary);
    cursor: pointer;
    font-size: var(--fs-sm);
    font-weight: 700;
    list-style: none;
  }

  .language-switcher__trigger::-webkit-details-marker {
    display: none;
  }

  .language-switcher__trigger:hover,
  .language-menu[open] .language-switcher__trigger {
    border-color: var(--color-accent-1);
  }

  .language-switcher__trigger:focus-visible,
  .language-switcher__options a:focus-visible {
    outline: 3px solid var(--color-accent-1);
    outline-offset: 3px;
  }

  .language-switcher__current {
    min-width: 1.5rem;
    letter-spacing: 0.04em;
  }

  .language-switcher__options {
    position: absolute;
    z-index: 40;
    top: calc(100% + var(--space-2));
    right: 0;
    display: grid;
    min-width: 12rem;
    gap: var(--space-1);
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
    box-shadow: var(--shadow-md);
  }

  .language-switcher__options a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0 var(--space-3);
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .language-switcher__options a:hover,
  .language-switcher__options a[aria-current='page'] {
    background: var(--color-surface);
  }

  .language-switcher__options a[aria-current='page'] .language-switcher__name::after {
    content: ' ✓';
    color: var(--color-accent-1);
  }

  .language-switcher__code {
    grid-column: 2;
    grid-row: 1 / span 2;
    color: var(--color-text-secondary);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .language-switcher__options small {
    grid-column: 1;
    color: var(--color-accent-1);
    font-size: var(--fs-xs);
  }

  .language-suggestion {
    position: static;
    grid-column: 1;
    grid-row: 2;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    width: 100%;
    max-width: 22rem;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
    color: var(--color-text-secondary);
    font-size: var(--fs-xs);
  }

  .language-suggestion[hidden],
  .language-switcher__options small[hidden] {
    display: none;
  }

  .language-control:has(.language-menu[open]) .language-suggestion {
    display: none;
  }

  .language-suggestion a {
    white-space: nowrap;
    font-weight: 700;
  }

  .language-suggestion button {
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font-size: 1rem;
  }

  @media (max-width: 40rem) {
    .language-switcher__trigger {
      min-width: 3.5rem;
      min-height: 2.75rem;
      padding-inline: var(--space-2);
    }

    .language-switcher__options {
      right: 0;
      min-width: 11rem;
    }
  }
</style>
