---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrapper site-footer__inner">
    <p class="site-footer__tagline">Know what fits before you buy, arrange or move it.</p>
    <nav aria-label="Footer">
      <ul>
        <li>
          <a href="/will-it-fit/">Universal fit check</a>
        </li>
        <li>
          <a href="/dining/">Dining room fit</a>
        </li>
        <li>
          <a href="/fit-services/">More fit services</a>
        </li>
        <li>
          <a href="/fit-services/">Appliance, route, garage and more fit tools</a>
        </li>
        <li>
          <a href="/about/">About &amp; data sources</a>
        </li>
        <li>
          <a href="/methodology/">How Fitwise calculates fit</a>
        </li>
        <li>
          <a href="/about/#corrections">Corrections policy</a>
        </li>
        <li>
          <a href="/workspace/">Workspace</a>
        </li>
        <li>
          <a href="/bedroom/">Bedroom</a>
        </li>
      </ul>
    </nav>
    <p class="site-footer__copy">&copy; {year} Fitwise.stream</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-8);
    padding-block: var(--space-6);
    color: var(--color-text-secondary);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .site-footer__tagline {
    margin: 0;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .site-footer nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer nav a {
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: var(--fs-sm);
  }

  .site-footer nav a:hover {
    color: var(--color-accent-1);
  }

  .site-footer__copy {
    margin: 0;
    font-size: var(--fs-sm);
  }
</style>
