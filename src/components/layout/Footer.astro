---
import {
  ALL_FIT_CHECKS_LINK,
  FIT_CHECK_GROUPS,
  GUIDE_LINKS,
  UNIVERSAL_FIT_LINK,
} from '../../data/navigation';
import type { NavigationLink } from '../../data/navigation';
import { localeFromPath, pathForLocale, type Locale } from '../../i18n/locale';
import { translateRequired } from '../../i18n/text';

const year = new Date().getFullYear();
const locale: Locale = localeFromPath(Astro.url.pathname);
const localizeLink = (link: NavigationLink): NavigationLink => ({
  ...link,
  href: pathForLocale(link.href, locale),
  label: translateRequired(locale, link.label),
});
const universalLink = localizeLink(UNIVERSAL_FIT_LINK);
const allFitChecksLink = localizeLink(ALL_FIT_CHECKS_LINK);
const fitCheckGroups = FIT_CHECK_GROUPS.map((group) => ({
  ...group,
  label: translateRequired(locale, group.label),
  links: group.links.map(localizeLink),
}));
const guideLinks = GUIDE_LINKS.map(localizeLink);
---

<footer class="site-footer" data-site-footer>
  <div class="wrapper site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__tagline">
        {translateRequired(locale, 'Know what fits before you buy, arrange or move it.')}
      </p>
      <p class="site-footer__summary">
        {translateRequired(
          locale,
          'Measure the item and space, compare clearances, and check model-specific requirements.',
        )}
      </p>
    </div>
    <div class="site-footer__navigation">
      <nav
        class="site-footer__fit-checks"
        aria-label={translateRequired(locale, 'Footer fit checks')}
      >
        <ul class="site-footer__primary">
          <li>
            <a href={universalLink.href}>{universalLink.label}</a>
          </li>
          <li>
            <a href={allFitChecksLink.href}>{allFitChecksLink.label}</a>
          </li>
        </ul>
        <div class="site-footer__groups">
          {fitCheckGroups.map((group) => (
            <section class="site-footer__group" aria-label={group.label}>
              <h2>{group.label}</h2>
              <ul>
                {group.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </nav>
      <nav class="site-footer__guides" aria-label={translateRequired(locale, 'Footer guides')}>
        <h2>{translateRequired(locale, 'Guides')}</h2>
        <ul>
          {guideLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <nav
        class="site-footer__site-info"
        aria-label={translateRequired(locale, 'Site information')}
      >
        <h2>FitWise</h2>
        <ul>
          <li>
            <a href={pathForLocale('/methodology/', locale)}>
              {translateRequired(locale, 'Methodology')}
            </a>
          </li>
          <li>
            <a href={pathForLocale('/about/', locale)}>
              {translateRequired(locale, 'About and data sources')}
            </a>
          </li>
          <li>
            <a href={`${pathForLocale('/about/', locale)}#corrections`}>
              {translateRequired(locale, 'Corrections policy')}
            </a>
          </li>
        </ul>
      </nav>
    </div>
    <p class="site-footer__copy">&copy; {year} Fitwise.stream</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-8);
    padding-block: var(--space-6);
    color: var(--color-text-secondary);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-5);
  }

  .site-footer__brand {
    max-width: 72ch;
  }

  .site-footer__tagline {
    margin: 0;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .site-footer__summary {
    margin: var(--space-2) 0 0;
    font-size: var(--fs-sm);
    line-height: 1.5;
  }

  .site-footer__navigation {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(2, minmax(10rem, 0.6fr));
    gap: var(--space-5);
  }

  .site-footer__primary,
  .site-footer__group ul,
  .site-footer__guides ul,
  .site-footer__site-info ul {
    display: grid;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer__primary {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .site-footer__groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
    gap: var(--space-4);
  }

  .site-footer__group h2,
  .site-footer__guides h2,
  .site-footer__site-info h2 {
    margin: 0 0 var(--space-2);
    color: var(--color-text-primary);
    font-size: var(--fs-sm);
  }

  .site-footer__navigation nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-text-secondary);
    font-size: var(--fs-sm);
    text-decoration: none;
  }

  .site-footer__navigation nav a:hover {
    color: var(--color-accent-1);
    text-decoration: underline;
  }

  .site-footer__primary a {
    font-weight: 700;
  }

  .site-footer__copy {
    margin: 0;
    font-size: var(--fs-sm);
  }

  @media (max-width: 48rem) {
    .site-footer__navigation {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
    }
  }
</style>
