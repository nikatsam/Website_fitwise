---
interface NavItem {
  href: string;
  label: string;
}

const fitCheckLinks: NavItem[] = [
  { href: '/will-it-fit/', label: 'Universal fit' },
  { href: '/workspace/', label: 'Workspace' },
  { href: '/bedroom/', label: 'Bedroom' },
  { href: '/dining/', label: 'Dining' },
  { href: '/garden/', label: 'Garden' },
  { href: '/fit-services/', label: 'Appliance, route and equipment checks' },
];

const guideLinks: NavItem[] = [
  { href: '/workspace/desk-size-guide/', label: 'Desk sizing' },
  { href: '/workspace/what-fits-on-a-140cm-desk/', label: 'What fits on a 140 cm desk' },
  { href: '/workspace/monitor-size-chart/', label: 'Monitor size chart' },
  { href: '/bedroom/what-size-bed-fits-my-room/', label: 'Bed and room sizing' },
  { href: '/bedroom/what-bed-fits-in-10x10-room/', label: 'Bed fit in a 10 × 10 room' },
  { href: '/methodology/reference-conventions/', label: 'Measurement conventions' },
];

const currentPath = new URL(Astro.request.url).pathname;
---

<header class="site-header">
  <div class="wrapper site-header__inner">
    <a href="/" class="brand" aria-label="Fitwise.stream home">
      <img
        src="/assets/images/logo.svg"
        alt=""
        width="150"
        height="33"
        class="brand__logo brand__logo--light"
      />
      <img
        src="/assets/images/logo-dark.svg"
        alt=""
        width="150"
        height="33"
        class="brand__logo brand__logo--dark"
      />
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul class="site-nav__list">
        <li class="site-nav__group">
          <details data-nav-group>
            <summary>Fit checks</summary>
            <ul class="site-nav__submenu">
              {fitCheckLinks.map((item) => (
                <li>
                  <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </li>
        <li class="site-nav__group">
          <details data-nav-group>
            <summary>Guides</summary>
            <ul class="site-nav__submenu">
              {guideLinks.map((item) => (
                <li>
                  <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </li>
        <li>
          <a
            href="/methodology/"
            aria-current={currentPath === '/methodology/' ? 'page' : undefined}
          >
            Methodology
          </a>
        </li>
        <li>
          <a href="/about/" aria-current={currentPath === '/about/' ? 'page' : undefined}>
            About
          </a>
        </li>
      </ul>
    </nav>

    <button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false">
      🌙 Dark
    </button>
  </div>
</header>

<script>
  import '../../scripts/theme';
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding-block: var(--space-3);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .brand__logo {
    height: 1.75rem;
    width: auto;
  }

  .brand__logo--dark {
    display: none;
  }

  :root[data-theme='dark'] .brand__logo--light {
    display: none;
  }

  :root[data-theme='dark'] .brand__logo--dark {
    display: block;
  }

  .site-nav {
    flex: 1;
    min-width: 0;
  }

  .site-nav__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-4) var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav a,
  .site-nav summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-text-secondary);
    text-decoration: none;
    font-weight: 600;
    font-size: var(--fs-sm);
    padding: var(--space-2) 0;
    position: relative;
  }

  .site-nav summary {
    cursor: pointer;
    list-style: none;
  }

  .site-nav summary::-webkit-details-marker {
    display: none;
  }

  .site-nav summary::after {
    content: '▾';
    font-size: 0.8em;
  }

  .site-nav__group {
    position: relative;
  }

  .site-nav__submenu {
    position: absolute;
    z-index: 30;
    top: calc(100% + var(--space-2));
    left: 0;
    display: grid;
    min-width: 15rem;
    max-width: min(22rem, calc(100vw - 2rem));
    gap: var(--space-1);
    margin: 0;
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
    box-shadow: var(--shadow-md);
    list-style: none;
  }

  .site-nav__submenu a {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
  }

  .site-nav__submenu a:hover,
  .site-nav__submenu a:focus-visible {
    background: var(--color-surface);
  }

  .site-nav a[aria-current='page'] {
    color: var(--color-text-primary);
  }

  .site-nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--gradient-brand);
    border-radius: var(--radius-pill);
  }

  .theme-toggle {
    border: 1px solid var(--color-border);
    background: var(--color-surface-raised);
    color: var(--color-text-primary);
    border-radius: var(--radius-pill);
    padding: var(--space-2) var(--space-4);
    font-size: var(--fs-sm);
    font-weight: 600;
    cursor: pointer;
    transition:
      transform var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-fast) var(--ease-standard);
  }

  .theme-toggle:hover {
    box-shadow: var(--shadow-sm);
    transform: translateY(-1px);
  }

  @media (max-width: 40rem) {
    .site-header__inner {
      flex-wrap: wrap;
    }
    .site-nav {
      order: 3;
      flex-basis: 100%;
    }
    .site-nav__list {
      justify-content: flex-start;
      gap: var(--space-2) var(--space-4);
    }
    .site-nav__submenu {
      left: auto;
      right: 0;
    }
  }
</style>
