---
import {
  ADVANCED_FIT_CHECK_LINK,
  ALL_FIT_CHECKS_LINK,
  FIT_CHECK_GROUPS,
  GUIDE_LINKS,
  UNIVERSAL_FIT_LINK,
  getNavigationCurrent,
} from '../../data/navigation';
import type { NavigationLink } from '../../data/navigation';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { localeFromPath, pathForLocale, type Locale } from '../../i18n/locale';
import { translateRequired, translateTemplate } from '../../i18n/text';

interface Props {
  showLanguageSwitcher?: boolean;
}

const { showLanguageSwitcher = true } = Astro.props;
const currentPath = new URL(Astro.request.url).pathname;
const locale: Locale = localeFromPath(currentPath);
const shouldShowLanguageSwitcher = showLanguageSwitcher && !currentPath.startsWith('/dev/');
const localizeLink = (link: NavigationLink): NavigationLink => ({
  ...link,
  href: pathForLocale(link.href, locale),
  label: translateRequired(locale, link.label),
  ...(link.activeRoutes
    ? { activeRoutes: link.activeRoutes.map((route) => pathForLocale(route, locale)) }
    : {}),
});
const universalLink = localizeLink(UNIVERSAL_FIT_LINK);
const allFitChecksLink = localizeLink(ALL_FIT_CHECKS_LINK);
const fitCheckGroups = FIT_CHECK_GROUPS.map((group) => ({
  ...group,
  label: translateRequired(locale, group.label),
  links: group.links.map(localizeLink),
  specialistGroups: group.specialistGroups?.map((specialistGroup) => ({
    ...specialistGroup,
    label: translateRequired(locale, specialistGroup.label),
    links: specialistGroup.links.map(localizeLink),
  })),
}));
const guideLinks = GUIDE_LINKS.map(localizeLink);
const fitCheckLinks = fitCheckGroups.flatMap((group) => [
  ...group.links,
  ...(group.specialistGroups?.flatMap((specialistGroup) => specialistGroup.links) ?? []),
]);
const activeFitCheck =
  (currentPath === pathForLocale(ADVANCED_FIT_CHECK_LINK.href, locale)
    ? localizeLink(ADVANCED_FIT_CHECK_LINK)
    : undefined) ??
  fitCheckLinks.find((link) => getNavigationCurrent(currentPath, link.href) === 'page') ??
  fitCheckLinks.find((link) => getNavigationCurrent(currentPath, link.href) === 'location');
const homePath = pathForLocale('/', locale);
const darkLabel = translateRequired(locale, 'Dark');
const lightLabel = translateRequired(locale, 'Light');
const themeLabel = translateRequired(locale, 'Theme');
const themeAriaLabel = translateTemplate(locale, 'Theme: {theme}', { theme: lightLabel });
---

<header class="site-header">
  <div class="wrapper site-header__inner">
    <a
      href={homePath}
      class="brand"
      aria-label={translateRequired(locale, 'Fitwise.stream home')}
      aria-current={currentPath === homePath ? 'page' : undefined}
    >
      <img
        src="/assets/images/logo.svg"
        alt=""
        width="150"
        height="33"
        class="brand__logo brand__logo--light"
      />
      <img
        src="/assets/images/logo-dark.svg"
        alt=""
        width="150"
        height="33"
        class="brand__logo brand__logo--dark"
      />
    </a>

    <button
      type="button"
      class="mobile-nav-toggle"
      data-mobile-nav-toggle
      data-mobile-nav-open-label={translateRequired(locale, 'Menu')}
      data-mobile-nav-close-label={translateRequired(locale, 'Close menu')}
      aria-controls="site-navigation"
      aria-expanded="false"
      hidden
    >
      <svg
        viewBox="0 0 20 20"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        aria-hidden="true"
      >
        <path d="M3 5h14M3 10h14M3 15h14" />
      </svg>
      <span data-mobile-nav-label>{translateRequired(locale, 'Menu')}</span>
    </button>

    <nav
      id="site-navigation"
      class="site-nav"
      aria-label={translateRequired(locale, 'Primary')}
      data-global-navigation
    >
      <ul class="site-nav__list">
        <li>
          <a
            href={universalLink.href}
            aria-current={getNavigationCurrent(currentPath, universalLink.href)}
          >
            {universalLink.label}
          </a>
        </li>
        <li class="site-nav__group">
          <details data-nav-group="fit-checks">
            <summary>
              {translateRequired(locale, 'Fit checks')}
              {activeFitCheck && (
                <span class="site-nav__current">
                  {translateRequired(locale, 'Current: {label}').replace(
                    '{label}',
                    activeFitCheck.label,
                  )}
                </span>
              )}
            </summary>
            <div class="site-nav__mega">
              {fitCheckGroups.map((group) => (
                <section class="site-nav__mega-group">
                  <h3>{group.label}</h3>
                  <ul>
                    {group.links.map((item) => (
                      <li>
                        <a
                          href={item.href}
                          aria-current={getNavigationCurrent(currentPath, item.href)}
                        >
                          {item.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </section>
              ))}
            </div>
          </details>
        </li>
        <li>
          <a
            href={allFitChecksLink.href}
            aria-current={getNavigationCurrent(
              currentPath,
              allFitChecksLink.href,
              allFitChecksLink.activeRoutes,
            )}
          >
            {allFitChecksLink.label}
          </a>
        </li>
        <li class="site-nav__group">
          <details data-nav-group="guides">
            <summary>{translateRequired(locale, 'Guides')}</summary>
            <ul class="site-nav__submenu">
              {guideLinks.map((item) => (
                <li>
                  <a href={item.href} aria-current={getNavigationCurrent(currentPath, item.href)}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </li>
        <li>
          <a
            href={pathForLocale('/methodology/', locale)}
            aria-current={getNavigationCurrent(currentPath, pathForLocale('/methodology/', locale))}
          >
            {translateRequired(locale, 'Methodology')}
          </a>
        </li>
        <li>
          <a
            href={pathForLocale('/about/', locale)}
            aria-current={getNavigationCurrent(currentPath, pathForLocale('/about/', locale))}
          >
            {translateRequired(locale, 'About')}
          </a>
        </li>
      </ul>
    </nav>

    <div class="site-header__tools">
      {shouldShowLanguageSwitcher && (
        <LanguageSwitcher currentPath={currentPath} language={locale} />
      )}
      <div class="theme-control">
        <span class="theme-control__label">{themeLabel}</span>
        <button
          type="button"
          class="theme-toggle"
          data-theme-toggle
          data-theme-dark-label={darkLabel}
          data-theme-light-label={lightLabel}
          data-theme-aria-label-template={translateRequired(locale, 'Theme: {theme}')}
          aria-label={themeAriaLabel}
          aria-pressed="false"
        >
          <span data-theme-icon aria-hidden="true">
            ☀️
          </span>
          <span data-theme-label>{lightLabel}</span>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  import '../../scripts/theme';

  const header = document.querySelector<HTMLElement>('.site-header');
  const navigation = document.getElementById('site-navigation');
  const mobileToggle = document.querySelector<HTMLButtonElement>('[data-mobile-nav-toggle]');
  const mobileQuery = window.matchMedia('(max-width: 40rem)');
  let mobileNavigationOpen = false;

  const syncMobileNavigation = () => {
    if (!header || !navigation || !mobileToggle) return;
    if (mobileQuery.matches) {
      mobileToggle.hidden = false;
      header.dataset.mobileNavEnhanced = 'true';
      navigation.dataset.mobileOpen = String(mobileNavigationOpen);
    } else {
      mobileToggle.hidden = true;
      delete header.dataset.mobileNavEnhanced;
      delete navigation.dataset.mobileOpen;
      mobileNavigationOpen = false;
    }
    mobileToggle.setAttribute('aria-expanded', String(mobileQuery.matches && mobileNavigationOpen));
    const label = mobileNavigationOpen
      ? mobileToggle.dataset.mobileNavCloseLabel
      : mobileToggle.dataset.mobileNavOpenLabel;
    const labelNode = mobileToggle.querySelector<HTMLElement>('[data-mobile-nav-label]');
    if (labelNode && label) labelNode.textContent = label;
  };

  mobileToggle?.addEventListener('click', () => {
    mobileNavigationOpen = !mobileNavigationOpen;
    syncMobileNavigation();
  });

  navigation?.addEventListener('click', (event) => {
    if (!mobileQuery.matches || !(event.target instanceof Element)) return;
    if (!event.target.closest('a')) return;
    mobileNavigationOpen = false;
    syncMobileNavigation();
  });

  navigation?.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !mobileNavigationOpen) return;
    const openGroup = navigation.querySelector<HTMLDetailsElement>('details[open]');
    if (openGroup) {
      openGroup.open = false;
      openGroup.querySelector('summary')?.focus();
      return;
    }
    mobileNavigationOpen = false;
    syncMobileNavigation();
    mobileToggle?.focus();
  });

  mobileQuery.addEventListener('change', syncMobileNavigation);
  syncMobileNavigation();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-5);
    padding-block: var(--space-3);
  }

  .site-header__tools {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-4);
    min-width: 0;
  }

  .mobile-nav-toggle {
    display: none;
  }

  .theme-control {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    flex: 0 0 auto;
  }

  .theme-control__label {
    color: var(--color-text-secondary);
    font-size: var(--fs-xs);
    font-weight: 700;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .brand__logo {
    height: 1.75rem;
    width: auto;
  }

  .brand__logo--dark {
    display: none;
  }

  :root[data-theme='dark'] .brand__logo--light {
    display: none;
  }

  :root[data-theme='dark'] .brand__logo--dark {
    display: block;
  }

  .site-nav {
    min-width: 0;
  }

  .site-nav__list {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-4) var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav__list > li {
    flex: 0 0 auto;
  }

  .site-nav a,
  .site-nav summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-text-secondary);
    text-decoration: none;
    font-weight: 600;
    font-size: var(--fs-sm);
    padding: var(--space-2) 0;
    position: relative;
  }

  .site-nav__current {
    margin-inline-start: var(--space-1);
    color: var(--color-accent-1);
    font-size: var(--fs-xs);
    font-weight: 700;
  }

  .site-nav summary {
    cursor: pointer;
    list-style: none;
  }

  .site-nav summary::-webkit-details-marker {
    display: none;
  }

  .site-nav summary::after {
    content: '▾';
    font-size: 0.8em;
  }

  .site-nav__group {
    position: relative;
  }

  .site-nav__submenu {
    position: absolute;
    z-index: 30;
    top: calc(100% + var(--space-2));
    left: 0;
    display: grid;
    min-width: 15rem;
    max-width: min(22rem, calc(100vw - 2rem));
    gap: var(--space-1);
    margin: 0;
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
    box-shadow: var(--shadow-md);
    list-style: none;
  }

  .site-nav__mega {
    position: absolute;
    z-index: 30;
    top: calc(100% + var(--space-2));
    left: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: min(58rem, calc(100vw - 2rem));
    gap: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
    box-shadow: var(--shadow-md);
  }

  .site-nav__mega-group h3 {
    margin: 0 0 var(--space-2);
    color: var(--color-text-primary);
    font-size: var(--fs-sm);
  }

  .site-nav__mega-group ul {
    display: grid;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav__mega-group a {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
  }

  .site-nav__mega-group a:hover,
  .site-nav__mega-group a:focus-visible {
    background: var(--color-surface);
  }

  .site-nav__submenu a {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
  }

  .site-nav__submenu a:hover,
  .site-nav__submenu a:focus-visible {
    background: var(--color-surface);
  }

  .site-nav a[aria-current='page'],
  .site-nav a[aria-current='location'] {
    color: var(--color-text-primary);
  }

  .site-nav a[aria-current='page']::after,
  .site-nav a[aria-current='location']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--gradient-brand);
    border-radius: var(--radius-pill);
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface-raised);
    color: var(--color-text-primary);
    border-radius: var(--radius-pill);
    padding: var(--space-2) var(--space-4);
    font-size: var(--fs-sm);
    font-weight: 600;
    cursor: pointer;
    transition:
      transform var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-fast) var(--ease-standard);
  }

  .theme-toggle:hover {
    box-shadow: var(--shadow-sm);
    transform: translateY(-1px);
  }

  @media (max-width: 72rem) {
    .site-header__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: var(--space-4);
      row-gap: var(--space-2);
    }

    .site-header__tools {
      grid-column: 2;
      grid-row: 1;
      gap: var(--space-3);
    }

    .site-nav {
      grid-column: 1 / -1;
      grid-row: 2;
      width: 100%;
    }

    .site-nav__list {
      justify-content: flex-start;
      overflow-x: auto;
      scrollbar-width: thin;
    }
  }

  @media (max-width: 40rem) {
    .site-header__inner {
      column-gap: var(--space-2);
      row-gap: var(--space-2);
      padding-block: var(--space-2);
    }

    .brand__logo {
      height: 1.5rem;
    }

    .mobile-nav-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-2);
      min-height: 2.75rem;
      padding: var(--space-2) var(--space-3);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-pill);
      background: var(--color-surface-raised);
      color: var(--color-text-primary);
      font-size: var(--fs-sm);
      font-weight: 700;
      cursor: pointer;
    }

    .mobile-nav-toggle:focus-visible {
      outline: 3px solid var(--color-accent-1);
      outline-offset: 3px;
    }

    .site-header__tools {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-self: end;
      gap: var(--space-2);
    }

    .theme-control {
      gap: var(--space-1);
    }

    .theme-control__label {
      font-size: var(--fs-xs);
    }

    .site-nav {
      grid-column: 1 / -1;
      grid-row: 3;
    }

    .site-header[data-mobile-nav-enhanced='true'] .site-nav {
      display: none;
    }

    .site-header[data-mobile-nav-enhanced='true'] .site-nav[data-mobile-open='true'] {
      display: block;
    }

    .site-nav__list {
      justify-content: flex-start;
      flex-wrap: wrap;
      overflow: visible;
      gap: var(--space-2) var(--space-4);
    }

    .site-nav__list > li {
      flex: 0 0 auto;
    }

    .site-nav__list > .site-nav__group {
      flex: 0 0 100%;
    }

    .theme-toggle {
      min-height: 2.75rem;
      gap: var(--space-1);
      padding: var(--space-2) var(--space-3);
      font-size: var(--fs-xs);
    }

    .site-nav__submenu {
      position: static;
      max-width: 100%;
      min-width: 0;
      border: 0;
      box-shadow: none;
    }
    .site-nav__group {
      position: static;
      flex-basis: 100%;
    }
    .site-nav__mega {
      position: static;
      width: 100%;
      grid-template-columns: 1fr;
      max-height: 65vh;
      overflow-y: auto;
      padding: var(--space-2) 0;
      border: 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
    }
    .site-nav__mega-group {
      padding: var(--space-2) 0;
      border-bottom: 1px solid var(--color-border);
    }
  }
</style>
