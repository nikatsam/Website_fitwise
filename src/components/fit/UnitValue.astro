---
import { formatMarginMeasurement, formatMeasurement } from '../../lib/units';

interface Props {
  mm: number;
  /** Stable id so a client script can update this value in place (see T012). */
  id?: string;
  /** Keeps nonzero fit margins visible below the normal display precision. */
  margin?: boolean;
}

const { mm, id, margin = false } = Astro.props;
const formatValue = (system: 'metric' | 'imperial') =>
  margin ? formatMarginMeasurement(mm, system) : formatMeasurement(mm, system);
---

<span class="unit-value" id={id}>
  <span data-unit="metric">{formatValue('metric')}</span>
  <span data-unit="separator" aria-hidden="true">
    {' '}
    /{' '}
  </span>
  <span data-unit="imperial">{formatValue('imperial')}</span>
</span>
