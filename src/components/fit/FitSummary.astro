---
import type { FitState, DimensionDisplayRow } from '../../lib/fit';
import {
  FIT_STATE_BADGE_COPY,
  getFailedDimensionRows,
  selectSummaryDimension,
} from '../../lib/fit';
import UnitValue from './UnitValue.astro';
import { formatMeasurement } from '../../lib/units';

interface Props {
  state: FitState;
  rows: DimensionDisplayRow[];
  /** Stable root id so client scripts can update this summary in place (e.g. T012 FitCheck). */
  id?: string;
  /** Optional dimension-table target for the mobile sticky result bar. */
  resultId?: string;
  /** Required manufacturer/manual data that is not yet verified. */
  needsInformation?: string[];
}

const { state, rows, id, resultId, needsInformation = [] } = Astro.props;
const { icon, label } = FIT_STATE_BADGE_COPY[state];
const primary = selectSummaryDimension(rows);
const { hardFailures, recommendationFailures } = getFailedDimensionRows(rows);
const formatUnit = (mm: number) => formatMeasurement(mm, 'metric');
---

<div class="fit-summary" data-fit-state={state} id={id}>
  <p class="fit-summary__badge">
    <span class="fit-summary__icon" aria-hidden="true" data-field="icon">
      {icon}
    </span>
    <span class="fit-summary__label" data-field="label">
      {label}
    </span>
  </p>

  <p class="fit-summary__detail" data-field="detail" aria-live="polite" aria-atomic="true">
    {state === 'fits' && primary && (
      <>
        Fits. Tightest constraint: {primary.label}. Physical space remaining:{' '}
        <UnitValue mm={primary.physicalMarginMm} />. After your selected target:{' '}
        <UnitValue mm={primary.targetMarginMm} />.
      </>
    )}
    {state === 'tight' && (
      <>
        Physical space remains, but selected targets are short on{' '}
        {recommendationFailures
          .map((row) => `${row.label} by ${formatUnit(Math.abs(row.targetMarginMm))}`)
          .join(', ')}
        . See physical and target margins below.
      </>
    )}
    {state === 'does_not_fit' && (
      <>
        Does not fit — the available space is short for{' '}
        {hardFailures
          .map((row) => `${row.label} by ${formatUnit(Math.abs(row.physicalMarginMm))}`)
          .join(', ')}
        . See the table for each dimension's physical and target margins.
      </>
    )}
    {state === 'needs_information' && (
      <>
        Physical footprint can be shown, but fit is not confirmed. Needed before a complete result:{' '}
        {needsInformation.join('; ')}.
      </>
    )}
  </p>
  {resultId && (
    <a
      class="fit-summary__mobile-link"
      data-fit-sticky
      data-fit-state={state}
      href={`#${resultId}`}
      aria-label={`Fit result: ${label}. View dimension details.`}
    >
      <span class="fit-summary__mobile-status">
        <span aria-hidden="true" data-field="sticky-icon">
          {icon}
        </span>
        <strong data-field="sticky-label">{label}</strong>
      </span>
      <span class="fit-summary__mobile-detail" data-field="sticky-detail">
        {state === 'fits' && primary && (
          <>
            <UnitValue mm={Math.max(0, primary.targetMarginMm)} /> after target
          </>
        )}
        {state === 'tight' && 'Target short'}
        {state === 'does_not_fit' && 'Physical short'}
        {state === 'needs_information' && 'Manual data needed'}
      </span>
      <span>View details ↑</span>
    </a>
  )}
</div>

<style>
  .fit-summary {
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background: var(--color-surface-raised);
  }

  .fit-summary[data-fit-state='fits'] {
    background: var(--color-state-fit-bg);
    color: var(--color-state-fit-fg);
    border-color: transparent;
  }

  .fit-summary[data-fit-state='tight'] {
    background: var(--color-state-tight-bg);
    color: var(--color-state-tight-fg);
    border-color: transparent;
  }

  .fit-summary[data-fit-state='does_not_fit'] {
    background: var(--color-state-no-fit-bg);
    color: var(--color-state-no-fit-fg);
    border-color: transparent;
  }

  .fit-summary[data-fit-state='needs_information'] {
    background: var(--color-state-tight-bg);
    color: var(--color-state-tight-fg);
    border-color: transparent;
  }

  .fit-summary__badge {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-2);
    font-size: var(--fs-lg);
    font-weight: 700;
  }

  .fit-summary__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5em;
    height: 1.5em;
    border-radius: 50%;
    background: currentColor;
    font-size: 0.75em;
  }

  /* The glyph itself renders in the surface color so it reads against the currentColor disc. */
  .fit-summary__icon {
    color: var(--color-surface-raised);
  }

  .fit-summary__detail {
    margin: 0;
    color: inherit;
    opacity: 0.92;
  }

  .fit-summary__mobile-link {
    display: none;
  }

  @media (max-width: 59.999rem) {
    .fit-summary__mobile-link {
      position: fixed;
      z-index: 100;
      right: 0;
      bottom: 0;
      left: 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3);
      min-height: 3.75rem;
      padding: var(--space-3) max(var(--space-4), env(safe-area-inset-left, 0px))
        calc(var(--space-3) + env(safe-area-inset-bottom, 0px))
        max(var(--space-4), env(safe-area-inset-right, 0px));
      border-top: 1px solid var(--color-border);
      background: var(--color-surface-raised);
      color: var(--color-text-primary);
      box-shadow: 0 -0.25rem 1rem rgb(0 0 0 / 12%);
      font-size: var(--fs-sm);
      text-decoration: none;
    }

    .fit-summary__mobile-link[data-fit-state='fits'] {
      background: var(--color-state-fit-bg);
      color: var(--color-state-fit-fg);
    }

    .fit-summary__mobile-link[data-fit-state='tight'] {
      background: var(--color-state-tight-bg);
      color: var(--color-state-tight-fg);
    }

    .fit-summary__mobile-link[data-fit-state='does_not_fit'] {
      background: var(--color-state-no-fit-bg);
      color: var(--color-state-no-fit-fg);
    }

    .fit-summary__mobile-link[data-fit-state='needs_information'] {
      background: var(--color-state-tight-bg);
      color: var(--color-state-tight-fg);
    }

    .fit-summary__mobile-status {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
    }

    .fit-summary__mobile-detail {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    :global(body:has(.fit-summary__mobile-link)) {
      padding-bottom: 4.5rem;
    }
  }
</style>
