---
import type {
  FitState,
  DimensionDisplayRow,
  CompatibilitySummaryCheck,
  MissingRequirement,
} from '../../lib/fit';
import {
  FIT_STATE_BADGE_COPY,
  getFitSummaryCopy,
  getFitSummaryResultLabel,
  renderFitSummaryContentHtml,
} from '../../lib/fit';
import UnitValue from './UnitValue.astro';

interface Props {
  state: FitState;
  rows: DimensionDisplayRow[];
  /** Stable root id so client scripts can update this summary in place (e.g. T012 FitCheck). */
  id?: string;
  /** Optional dimension-table target for the mobile sticky result bar. */
  resultId?: string;
  /** Structured sources, manuals or compatibility facts that remain unverified. */
  missingRequirements?: MissingRequirement[];
  /** Product/manual compatibility results that are separate from physical dimensions. */
  compatibilityChecks?: CompatibilitySummaryCheck[];
  /** Marks server-rendered starter values as examples until the user edits the setup. */
  resultOrigin?: 'example' | 'user';
}

const {
  state,
  rows,
  id,
  resultId,
  missingRequirements = [],
  compatibilityChecks = [],
  resultOrigin,
} = Astro.props;
const summaryCopy = getFitSummaryCopy(state, rows, {
  missingRequirements,
  compatibilityChecks,
});
const { icon } = FIT_STATE_BADGE_COPY[state];
const label = getFitSummaryResultLabel(summaryCopy, resultOrigin);
---

<div
  class="fit-summary"
  data-fit-state={state}
  data-fit-exact={summaryCopy.isExactFit ? 'true' : undefined}
  data-fit-origin={resultOrigin}
  id={id}
>
  <p class="fit-summary__badge">
    <span class="fit-summary__icon" aria-hidden="true" data-field="icon">
      {icon}
    </span>
    <span class="fit-summary__label" data-field="label">
      {label}
    </span>
  </p>

  <div
    class="fit-summary__content"
    data-fit-summary-content
    set:html={renderFitSummaryContentHtml(summaryCopy)}
  />
  <details class="fit-summary__legend" data-fit-state-legend>
    <summary>What these results mean</summary>
    <ul>
      {Object.values(FIT_STATE_BADGE_COPY).map((fitState) => (
        <li>
          <strong>
            <span aria-hidden="true">{fitState.icon}</span> {fitState.label}:
          </strong>{' '}
          {fitState.meaning}
        </li>
      ))}
    </ul>
  </details>
  {resultId && (
    <a
      class="fit-summary__mobile-link"
      data-fit-sticky
      data-fit-state={state}
      href={`#${resultId}-details`}
      aria-label={`Fit result: ${label}. View calculation details.`}
    >
      <span class="fit-summary__mobile-status">
        <span aria-hidden="true" data-field="sticky-icon">
          {icon}
        </span>
        <strong data-field="sticky-label">{label}</strong>
      </span>
      <span class="fit-summary__mobile-detail" data-field="sticky-detail">
        {summaryCopy.isExactFit ? (
          'No tolerance remains'
        ) : summaryCopy.marginMm !== null && summaryCopy.marginLabel ? (
          <>
            <UnitValue mm={summaryCopy.marginMm} /> {summaryCopy.marginLabel.toLowerCase()}
          </>
        ) : null}
        {state === 'does_not_fit' && summaryCopy.physicalStatus === 'No' && 'Physical fit failed'}
        {state === 'does_not_fit' &&
          summaryCopy.compatibilityStatus === 'Incompatible' &&
          'Compatibility check failed'}
        {state === 'needs_information' && 'Manual data needed'}
      </span>
      <span>View details ↑</span>
    </a>
  )}
</div>

<script>
  function markEditedExampleAsUserResult(event: Event): void {
    const target = event.target;
    const isFieldChange =
      !(target instanceof HTMLInputElement) &&
      !(target instanceof HTMLSelectElement) &&
      !(target instanceof HTMLTextAreaElement);
    const isCandidateListChange =
      event.type === 'click' &&
      target instanceof Element &&
      target.closest('button[data-candidate-size-add], button[data-candidate-size-remove]');
    if (target instanceof HTMLInputElement && target.hasAttribute('data-unit-choice')) return;
    if (isFieldChange && !isCandidateListChange) {
      return;
    }

    const form = target instanceof Element ? target.closest('form') : null;
    const scope = form?.closest<HTMLElement>('[data-fit-result-scope]');
    const summary = scope?.querySelector<HTMLElement>('.fit-summary[data-fit-origin]');
    if (!form || !summary || summary.dataset.fitOrigin !== 'example') return;

    summary.dataset.fitOrigin = 'user';
    const notice = form.querySelector<HTMLElement>('[data-fit-example-notice]');
    if (notice) notice.hidden = true;

    const label = summary.querySelector<HTMLElement>('[data-field="label"]');
    const stateLabel = label?.textContent
      ?.trim()
      .replace(/^(Example result|Your result)\s*—\s*/, '');
    const resultLabel = `Your result — ${stateLabel ?? 'Fit result'}`;
    if (label) label.textContent = resultLabel;

    const sticky = summary.querySelector<HTMLAnchorElement>('[data-fit-sticky]');
    const stickyLabel = sticky?.querySelector<HTMLElement>('[data-field="sticky-label"]');
    if (stickyLabel) stickyLabel.textContent = resultLabel;
    if (sticky) {
      sticky.setAttribute(
        'aria-label',
        sticky.getAttribute('aria-label')?.replace(/Example result\s*—\s*/, 'Your result — ') ??
          `Fit result: ${resultLabel}. View calculation details.`,
      );
    }
  }

  document.addEventListener('input', markEditedExampleAsUserResult, true);
  document.addEventListener('change', markEditedExampleAsUserResult, true);
  document.addEventListener('click', markEditedExampleAsUserResult, true);
</script>

<style>
  .fit-summary {
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background: var(--color-surface-raised);
  }

  .fit-summary[data-fit-state='fits'] {
    background: var(--color-state-fit-bg);
    color: var(--color-state-fit-fg);
    border-color: transparent;
  }

  .fit-summary[data-fit-exact='true'] {
    border: 2px solid var(--color-state-tight-fg);
  }

  .fit-summary[data-fit-state='tight'] {
    background: var(--color-state-tight-bg);
    color: var(--color-state-tight-fg);
    border-color: transparent;
  }

  .fit-summary[data-fit-state='does_not_fit'] {
    background: var(--color-state-no-fit-bg);
    color: var(--color-state-no-fit-fg);
    border-color: transparent;
  }

  .fit-summary[data-fit-state='needs_information'] {
    background: var(--color-state-info-bg);
    color: var(--color-state-info-fg);
    border-color: transparent;
  }

  .fit-summary__badge {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-2);
    font-size: var(--fs-lg);
    font-weight: 700;
  }

  .fit-summary__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5em;
    height: 1.5em;
    border-radius: 50%;
    background: currentColor;
    font-size: 0.75em;
  }

  /* The glyph itself renders in the surface color so it reads against the currentColor disc. */
  .fit-summary__icon {
    color: var(--color-surface-raised);
  }

  .fit-summary__content {
    display: grid;
    gap: var(--space-3);
  }

  .fit-summary__content :global(.fit-summary__facts) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
    gap: var(--space-2);
    margin: 0;
  }

  .fit-summary__content :global(.fit-summary__facts > div) {
    padding: var(--space-2) var(--space-3);
    border: 1px solid currentColor;
    border-radius: var(--radius-sm);
  }

  .fit-summary__content :global(.fit-summary__facts dt) {
    font-size: var(--fs-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .fit-summary__content :global(.fit-summary__facts dd) {
    margin: var(--space-1) 0 0;
    font-weight: 700;
  }

  .fit-summary__content :global(.fit-summary__binding),
  .fit-summary__content :global(.fit-summary__margin),
  .fit-summary__content :global(.fit-summary__detail),
  .fit-summary__content :global(.fit-summary__next) {
    margin: 0;
    color: inherit;
    line-height: 1.5;
  }

  .fit-summary__content :global(.fit-summary__tolerance-warning) {
    margin: 0;
    padding: var(--space-2) var(--space-3);
    border-left: 0.25rem solid var(--color-state-tight-fg);
    color: inherit;
    font-weight: 700;
    line-height: 1.5;
  }

  .fit-summary__content :global(h3) {
    margin: 0 0 calc(-1 * var(--space-2));
    font-size: var(--fs-md);
  }

  .fit-summary__content :global(.fit-summary__missing) {
    padding: var(--space-3);
    border-left: 0.25rem solid var(--color-state-info-fg);
    background: var(--color-surface);
  }

  .fit-summary__content :global(.fit-summary__missing h3),
  .fit-summary__content :global(.fit-summary__missing p) {
    margin: 0;
  }

  .fit-summary__content :global(.fit-summary__missing ul) {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-2) 0 0;
    padding-inline-start: var(--space-5);
  }

  .fit-summary__content :global(.fit-summary__missing li) {
    display: grid;
    gap: var(--space-1);
  }

  .fit-summary__legend {
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid currentColor;
    font-size: var(--fs-sm);
  }

  .fit-summary__legend summary {
    width: fit-content;
    cursor: pointer;
    font-weight: 700;
  }

  .fit-summary__legend ul {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    padding-left: 1.25rem;
  }

  .fit-summary__legend li {
    line-height: 1.45;
  }

  .fit-summary__mobile-link {
    display: none;
  }

  @media (max-width: 61.999rem) {
    .fit-summary__mobile-link {
      position: fixed;
      z-index: 100;
      right: 0;
      bottom: 0;
      left: 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3);
      min-height: 3.75rem;
      padding: var(--space-3) max(var(--space-4), env(safe-area-inset-left, 0px))
        calc(var(--space-3) + env(safe-area-inset-bottom, 0px))
        max(var(--space-4), env(safe-area-inset-right, 0px));
      border-top: 1px solid var(--color-border);
      background: var(--color-surface-raised);
      color: var(--color-text-primary);
      box-shadow: 0 -0.25rem 1rem rgb(0 0 0 / 12%);
      font-size: var(--fs-sm);
      text-decoration: none;
    }

    .fit-summary__mobile-link[data-fit-state='fits'] {
      background: var(--color-state-fit-bg);
      color: var(--color-state-fit-fg);
    }

    .fit-summary__mobile-link[data-fit-state='tight'] {
      background: var(--color-state-tight-bg);
      color: var(--color-state-tight-fg);
    }

    .fit-summary__mobile-link[data-fit-state='does_not_fit'] {
      background: var(--color-state-no-fit-bg);
      color: var(--color-state-no-fit-fg);
    }

    .fit-summary__mobile-link[data-fit-state='needs_information'] {
      background: var(--color-state-info-bg);
      color: var(--color-state-info-fg);
    }

    .fit-summary__mobile-status {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
    }

    .fit-summary__mobile-detail {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    :global(body:has(.fit-summary__mobile-link)) {
      padding-bottom: 4.5rem;
    }
  }
</style>
