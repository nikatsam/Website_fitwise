---
import {
  MEASUREMENT_DIAGRAM_COPY,
  renderMeasurementSketchContents,
  type MeasurementDiagram,
} from '../../lib/fit/measurement-guidance';
import { localeFromPath } from '../../i18n/locale';
import { translateRequired, translateTemplate } from '../../i18n/text';

interface Props {
  id: string;
  label: string;
  summaryHelp: string;
  measureHelp: string;
  example?: string;
  warning?: string;
  sourceRequirement?: string;
  diagram?: MeasurementDiagram;
}

const { id, label, summaryHelp, measureHelp, example, warning, sourceRequirement, diagram } =
  Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const diagramCopy = diagram ? MEASUREMENT_DIAGRAM_COPY[diagram] : null;
---

<div class="measurement-help" data-measurement-help={id}>
  <details class="measurement-help__details">
    <summary
      aria-label={translateTemplate(locale, 'Show detailed measuring help: {label}', {
        label: translateRequired(locale, label),
      })}
    >
      <span class="measurement-help__summary" id={id}>
        {translateRequired(locale, summaryHelp)}
      </span>
      <span class="measurement-help__indicator" aria-hidden="true">
        ?
      </span>
    </summary>
    <div class="measurement-help__content">
      <h3>{translateRequired(locale, label)}</h3>
      <p>{translateRequired(locale, measureHelp)}</p>
      {example && (
        <p class="measurement-help__example">
          <strong>{translateRequired(locale, 'Example')}:</strong>{' '}
          {translateRequired(locale, example)}
        </p>
      )}
      {warning && (
        <p class="measurement-help__warning">
          <strong>{translateRequired(locale, 'Check')}:</strong>{' '}
          {translateRequired(locale, warning)}
        </p>
      )}
      {sourceRequirement && (
        <p class="measurement-help__source">
          <strong>{translateRequired(locale, 'Source requirement')}:</strong>{' '}
          {translateRequired(locale, sourceRequirement)}
        </p>
      )}
      <slot />
    </div>
    {diagram && (
      <figure class="measurement-help__diagram">
        <svg
          viewBox="0 0 280 112"
          role="img"
          aria-labelledby={`${id}-diagram-title ${id}-diagram-desc`}
        >
          <title
            id={`${id}-diagram-title`}
          >{diagramCopy && translateRequired(locale, diagramCopy.title)}</title>
          <desc id={`${id}-diagram-desc`}>
            {diagramCopy && translateRequired(locale, diagramCopy.description)}{' '}
            {translateRequired(locale, 'Diagram is not to scale.')}
          </desc>
          <g set:html={renderMeasurementSketchContents(diagram, locale)} />
        </svg>
        <figcaption>
          {translateRequired(locale, 'Illustrative plan sketch; not to scale.')}
        </figcaption>
      </figure>
    )}
  </details>
</div>
