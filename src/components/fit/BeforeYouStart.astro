---
import type { BeforeYouStartItem } from '../../lib/fit/start-guidance';

interface Props {
  id: string;
  items: readonly BeforeYouStartItem[];
  spansGrid?: boolean;
}

const { id, items, spansGrid = false } = Astro.props;
---

<section
  class:list={['before-you-start', { 'before-you-start--wide': spansGrid }]}
  id={id}
  data-before-you-start
  aria-labelledby={`${id}-heading`}
>
  <h2 id={`${id}-heading`}>Before you start</h2>
  <ul data-before-you-start-items>
    {items.map((item) => (
      <li data-preparation-type={item.type}>
        <span class="before-you-start__type">
          {item.type === 'verification'
            ? 'For verification'
            : item.type === 'required'
              ? 'Required'
              : 'Optional'}
        </span>
        <span>{item.text}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .before-you-start {
    max-width: 82ch;
    padding: var(--space-4);
    border-inline-start: 3px solid var(--color-accent-1);
    border-radius: var(--radius-sm);
    background: var(--color-surface-raised);
  }

  .before-you-start--wide {
    grid-column: 1 / -1;
  }

  .before-you-start h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--fs-md);
  }

  .before-you-start ul {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding-inline-start: 1.25rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .before-you-start :global(li[data-preparation-type]) {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    align-items: start;
    gap: var(--space-2);
  }

  .before-you-start :global(.before-you-start__type) {
    color: var(--color-text-primary);
    font-size: var(--fs-xs);
    font-weight: 700;
  }
</style>
