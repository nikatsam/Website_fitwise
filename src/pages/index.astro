---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Fitwise.stream — Know what fits before you buy"
  description="Check whether furniture, appliances, equipment and room layouts fit using your measured dimensions. Enter metric or imperial units and review space, doorway and corridor constraints."
  canonicalPath="/"
  structuredData={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      '@id': 'https://fitwise.stream/#website',
      url: 'https://fitwise.stream/',
      name: 'Fitwise.stream',
      inLanguage: 'en',
    },
    {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      '@id': 'https://fitwise.stream/#webpage',
      url: 'https://fitwise.stream/',
      name: 'Fitwise.stream — Know what fits before you buy',
      description:
        'Check whether furniture, appliances, equipment and room layouts fit using your measured dimensions. Enter metric or imperial units and review space, doorway and corridor constraints.',
      inLanguage: 'en',
      isPartOf: { '@id': 'https://fitwise.stream/#website' },
    },
  ]}
>
  <section class="hero">
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="wrapper hero__inner">
      <h1>Will it fit?</h1>
      <p class="hero__lede">
        What are you trying to fit? Start with the relationship: item, space, surface or opening.
      </p>

      <div class="hero__cards">
        <a class="hero__card" href="/will-it-fit/">
          <span class="hero__card-kicker">Object → Room</span>
          <span class="hero__card-title">Furniture, appliances or equipment</span>
        </a>
        <a class="hero__card" href="/bedroom/">
          <span class="hero__card-kicker">Objects → Room</span>
          <span class="hero__card-title">Bed, bedside tables and clearance</span>
        </a>
        <a class="hero__card" href="/dining/">
          <span class="hero__card-kicker">Objects → Room</span>
          <span class="hero__card-title">Dining table, chairs and circulation</span>
        </a>
        <a class="hero__card" href="/fit-services/">
          <span class="hero__card-kicker">Other fit relationships</span>
          <span class="hero__card-title">
            Appliance, route, compatibility, TV, gym, storage, pool and garage checks
          </span>
        </a>
        <a class="hero__card" href="/workspace/">
          <span class="hero__card-kicker">Objects → Surface</span>
          <span class="hero__card-title">Monitors and workspace layouts</span>
        </a>
        <a class="hero__card" href="/will-it-fit/">
          <span class="hero__card-kicker">Object → Opening</span>
          <span class="hero__card-title">Screen an upright doorway and corridor fit</span>
        </a>
        <a class="hero__card" href="/bedroom/">
          <span class="hero__card-kicker">Operating clearance</span>
          <span class="hero__card-title">Check a wardrobe door or dresser drawer</span>
        </a>
      </div>
    </div>
  </section>

  <section class="wrapper section">
    <h2>Workspace planning</h2>
    <p>
      Check a workspace layout with your own dimensions, or compare sourced monitor and desk
      examples.
    </p>
    <a href="/workspace/">Browse workspace pages →</a>
    <nav class="reference-links" aria-label="Workspace sizing guides">
      <h3>Workspace sizing guides</h3>
      <ul>
        <li>
          <a href="/workspace/monitor-size-chart/">Monitor physical size chart</a>
        </li>
        <li>
          <a href="/workspace/what-fits-on-a-140cm-desk/">What fits on a 140 cm desk?</a>
        </li>
        <li>
          <a href="/workspace/desk-size-for-two-27-inch-monitors/">
            Desk width for two 27-inch monitors
          </a>
        </li>
        <li>
          <a href="/workspace/desk-depth-for-monitor/">Monitor stand depth and viewing distance</a>
        </li>
        <li>
          <a href="/workspace/desk-chair-clearance/">Office chair footprint and movement space</a>
        </li>
      </ul>
    </nav>
  </section>

  <section class="wrapper section">
    <h2>Bedroom planning</h2>
    <p>
      Start with your own bed and room measurements. Market-specific mattress references are
      available when useful, but the planner is not limited to them.
    </p>
    <a href="/bedroom/">Browse bedroom pages →</a>
    <nav class="reference-links" aria-label="Bed size and room guides">
      <h3>Bed size and room guides</h3>
      <ul>
        <li>
          <a href="/bedroom/us-bed-size-dimensions/">US bed size dimensions</a>
        </li>
        <li>
          <a href="/bedroom/uk-bed-size-dimensions/">UK bed size dimensions</a>
        </li>
        <li>
          <a href="/bedroom/minimum-room-size-for-queen-bed/">Room space for a US Queen mattress</a>
        </li>
        <li>
          <a href="/bedroom/minimum-room-size-for-king-bed/">
            Room space for a King mattress, US and UK
          </a>
        </li>
        <li>
          <a href="/bedroom/space-between-bed-and-wardrobe/">Bed and wardrobe door-swing example</a>
        </li>
        <li>
          <a href="/bedroom/bed-and-dresser-clearance/">Bed and open dresser-drawer example</a>
        </li>
        <li>
          <a href="/bedroom/king-bed-two-nightstands-room-size/">US King with two bedside tables</a>
        </li>
        <li>
          <a href="/bedroom/queen-bed-two-nightstands-room-size/">
            US Queen with two bedside tables
          </a>
        </li>
      </ul>
    </nav>
  </section>

  <section class="wrapper section">
    <h2>How Fitwise calculates fit</h2>
    <p>
      Sourced product dimensions are used where available; you can also enter your own measurements
      in metric or imperial units. Calculations keep physical fit, optional clearance targets and
      geometric assumptions separate. They are screening estimates, not guarantees or code checks.
    </p>
    <a href="/methodology/">Read the methodology →</a>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-8) var(--space-7);
    isolation: isolate;
  }

  .hero__glow {
    position: absolute;
    inset: -20% -10% auto -10%;
    height: 32rem;
    background:
      radial-gradient(
        45rem 20rem at 20% 20%,
        color-mix(in srgb, var(--color-accent-1) 35%, transparent),
        transparent 70%
      ),
      radial-gradient(
        40rem 22rem at 80% 10%,
        color-mix(in srgb, var(--color-accent-2) 30%, transparent),
        transparent 70%
      );
    z-index: -1;
    animation: drift 18s var(--ease-standard) infinite alternate;
  }

  @keyframes drift {
    from {
      transform: translate3d(0, 0, 0) scale(1);
    }
    to {
      transform: translate3d(2%, 3%, 0) scale(1.05);
    }
  }

  .hero__inner h1 {
    font-size: var(--fs-3xl);
    background: var(--gradient-brand);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    display: inline-block;
  }

  .hero__lede {
    font-size: var(--fs-md);
    color: var(--color-text-secondary);
    max-width: 38ch;
  }

  .hero__cards {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .hero__card {
    flex: 1 1 14rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: var(--color-text-primary);
    transition:
      transform var(--duration-base) var(--ease-standard),
      box-shadow var(--duration-base) var(--ease-standard);
  }

  .hero__card:hover,
  .hero__card:focus-visible {
    transform: translateY(-4px);
    box-shadow: var(--shadow-glow);
  }

  .hero__card-kicker {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-accent-1);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .hero__card-title {
    font-size: var(--fs-lg);
    font-weight: 700;
  }

  .section {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .section h2 {
    margin-bottom: var(--space-2);
  }

  .reference-links {
    margin-top: var(--space-4);
  }

  .reference-links ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__glow {
      animation: none;
    }
  }
</style>
