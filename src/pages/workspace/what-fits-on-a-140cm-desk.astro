---
// Representative 'space_to_object' page (tasks/T014): fixed space, several
// candidate configurations. noindex: not yet backed by a published PageIntent.
import BaseLayout from '../../layouts/BaseLayout.astro';
import SpaceToObjectTemplate from '../../components/content/templates/SpaceToObjectTemplate.astro';
import { buildBreadcrumb } from '../../lib/content';
import { evaluateFit } from '../../lib/fit';
import { buildWorkspaceWidthCheck, computeConfigurationWidth } from '../../lib/geometry';

const deskWidthMm = 1400;
const gapMm = 20;
const sideMarginMm = 38;

const candidateConfigs = [
  { label: 'One 27" monitor', widthsMm: [613] },
  { label: 'Two 24" monitors', widthsMm: [540, 540] },
  { label: 'Two 27" monitors', widthsMm: [613, 613] },
  { label: 'Two 32" monitors', widthsMm: [720, 720] },
  { label: 'Three 24" monitors', widthsMm: [540, 540, 540] },
];

const candidates = candidateConfigs.map((config) => {
  const configurationWidthMm = computeConfigurationWidth({ widthsMm: config.widthsMm, gapMm });
  const check = buildWorkspaceWidthCheck({
    configurationWidthMm,
    sideMarginRecommendedMm: sideMarginMm,
    deskWidthMm,
  });
  const result = evaluateFit([check]);
  return {
    label: config.label,
    requiredMm: check.minimumMm,
    availableMm: deskWidthMm,
    state: result.state,
  };
});

const h1 = `What fits on a ${deskWidthMm / 10}cm desk?`;
const breadcrumb = buildBreadcrumb('/workspace/what-fits-on-a-140cm-desk/', 'workspace');
---

<BaseLayout
  title={`${h1} — Fitwise.stream`}
  description="See which monitor configurations fit a 140 cm desk, from one monitor up to a triple-monitor setup."
  noindex
>
  <div class="wrapper">
    <SpaceToObjectTemplate
      breadcrumb={breadcrumb}
      h1={h1}
      intro={`A ${deskWidthMm / 10} cm desk fits these common monitor configurations, assuming a ${gapMm} mm gap between monitors and using the hard physical footprint as the required width.`}
      spaceLabel={`a ${deskWidthMm / 10}cm desk`}
      candidates={candidates}
      assumptions={[
        'Monitor widths are approximate, screen-only sizes for common diagonal presets.',
        `Gap between monitors: ${gapMm} mm.`,
        'Required width shown is the hard physical footprint only, not the recommended comfortable envelope.',
      ]}
    />
  </div>
</BaseLayout>
