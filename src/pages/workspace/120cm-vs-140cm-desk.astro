---
// Representative 'comparison' page (tasks/T014). noindex: not yet backed by
// a published PageIntent/SeoPublication record.
import PublishedLayout from '../../components/layout/PublishedLayout.astro';
import ComparisonTemplate from '../../components/content/templates/ComparisonTemplate.astro';
import { dataset } from '../../data';
import { evaluateFit } from '../../lib/fit';
import { buildWorkspaceConfigurationCheck, resolveMonitorWidth } from '../../lib/geometry';
import { formatMeasurement } from '../../lib/units';
import { buildPublicationBreadcrumbs } from '../../lib/seo/metadata';

const monitor = dataset.entities.find((entity) => entity.id === 'ent-display-27in-16x9');
const desks = ['ent-desk-1200', 'ent-desk-1400'].map((id) =>
  dataset.entities.find((entity) => entity.id === id),
);
const gapRule = dataset.clearanceRules.find((rule) => rule.id === 'clr-monitor-gap');
const sideMarginRule = dataset.clearanceRules.find((rule) => rule.id === 'clr-desk-side-margin');
if (
  monitor?.category !== 'display' ||
  desks.some((desk) => desk?.category !== 'desk') ||
  !gapRule ||
  !sideMarginRule
) {
  throw new Error('The desk comparison is missing its shared monitor, desk or clearance inputs.');
}
const monitorWidthMm = resolveMonitorWidth(monitor).valueMm;
const gapMm = gapRule.recommendedMm?.valueMm;
const sideMarginMm = sideMarginRule.recommendedMm?.valueMm;
if (gapMm === undefined || sideMarginMm === undefined) {
  throw new Error('The desk comparison requires gap and side-margin measurements.');
}

const calculations = desks.map((desk) => {
  if (desk?.category !== 'desk') throw new Error('A comparison desk has invalid category data.');
  const { configurationWidthMm, check } = buildWorkspaceConfigurationCheck({
    widthsMm: [monitorWidthMm, monitorWidthMm],
    gapMm,
    sideMarginRecommendedMm: sideMarginMm,
    deskWidthMm: desk.widthMm.valueMm,
  });
  return {
    deskWidthMm: desk.widthMm.valueMm,
    configurationWidthMm,
    minimumMarginMm: check.availableMm - check.minimumMm,
    recommendedWidthMm: check.recommendedMm!,
    recommendedMarginMm: check.availableMm - check.recommendedMm!,
    fits: evaluateFit([check]).hardFit,
  };
});

const formatCm = (valueMm: number) => formatMeasurement(valueMm, 'cm');
const signedCm = (valueMm: number) => `${valueMm > 0 ? '+' : ''}${formatCm(valueMm)}`;

const rowLabels = [
  'Available desk width',
  'Two-monitor physical width (including gap)',
  'Physical margin after monitors',
  'Target width including selected side-clearance',
  'Target margin after selected clearance',
  'Physical footprint fits',
];
const columns = calculations.map((calculation) => {
  return {
    title: formatCm(calculation.deskWidthMm),
    values: [
      formatCm(calculation.deskWidthMm),
      formatMeasurement(calculation.configurationWidthMm, 'cm'),
      signedCm(calculation.minimumMarginMm),
      formatMeasurement(calculation.recommendedWidthMm, 'cm'),
      signedCm(calculation.recommendedMarginMm),
      calculation.fits ? 'Yes' : 'No',
    ],
  };
});

const pageIntent = dataset.pageIntents.find((intent) => intent.id === 'pi-p013-120-vs-140cm-desk');
const publication = dataset.seoPublications.find(
  (record) => record.pageIntentId === 'pi-p013-120-vs-140cm-desk',
);
if (!pageIntent || !publication)
  throw new Error('The 120/140 desk comparison needs its publication metadata.');
const h1 = publication.h1;
const breadcrumb = buildPublicationBreadcrumbs(
  pageIntent,
  publication,
  dataset.pageIntents,
  dataset.seoPublications,
);
---

<PublishedLayout pageIntentId="pi-p013-120-vs-140cm-desk" showBreadcrumb={false}>
  <div class="wrapper">
    <ComparisonTemplate
      breadcrumb={breadcrumb}
      h1={h1}
      intro={`A shared geometry calculation compares two approximately ${formatMeasurement(monitorWidthMm)} screen-only widths with a ${formatMeasurement(gapMm)} gap. Physical margin excludes side targets; recommended margin includes ${formatMeasurement(sideMarginMm)} per side.`}
      rowLabels={rowLabels}
      columns={columns}
    />
  </div>
</PublishedLayout>
