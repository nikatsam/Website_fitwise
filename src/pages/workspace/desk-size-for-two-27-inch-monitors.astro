---
// Representative 'object_to_space' page (tasks/T014). noindex: not yet backed
// by a published PageIntent/SeoPublication record (T015-T017).
import BaseLayout from '../../layouts/BaseLayout.astro';
import FitAnswerTemplate from '../../components/content/templates/FitAnswerTemplate.astro';
import { dataset } from '../../data';
import { buildBreadcrumb } from '../../lib/content';
import { evaluateFit, toDimensionDisplayRows } from '../../lib/fit';
import { buildWorkspaceConfigurationCheck, resolveMonitorWidth } from '../../lib/geometry';
import { renderWorkspaceDiagramMarkup } from '../../lib/diagram';
import { formatMeasurement } from '../../lib/units';

const desk = dataset.entities.find((entity) => entity.id === 'ent-desk-1400');
const monitor = dataset.entities.find((entity) => entity.id === 'ent-display-27in-16x9');
const gapRule = dataset.clearanceRules.find((rule) => rule.id === 'clr-monitor-gap');
const sideMarginRule = dataset.clearanceRules.find((rule) => rule.id === 'clr-desk-side-margin');
if (desk?.category !== 'desk' || monitor?.category !== 'display' || !gapRule || !sideMarginRule) {
  throw new Error('The dual 27-inch monitor example is missing its shared model inputs.');
}
const deskWidthMm = desk.widthMm.valueMm;
const monitorWidthMm = resolveMonitorWidth(monitor).valueMm;
const gapMm = gapRule.recommendedMm?.valueMm;
const sideMarginMm = sideMarginRule.recommendedMm?.valueMm;
if (gapMm === undefined || sideMarginMm === undefined) {
  throw new Error('The dual 27-inch monitor example needs gap and side-margin measurements.');
}
const { check } = buildWorkspaceConfigurationCheck({
  widthsMm: [monitorWidthMm, monitorWidthMm],
  gapMm,
  sideMarginRecommendedMm: sideMarginMm,
  deskWidthMm,
});
const assumptions = [
  `Monitor width: approximate screen-only width derived from a 27" 16:9 diagonal and rounded to the nearest millimetre for fit checks; actual device is typically wider due to bezel.`,
  `Monitor depth (incl. stand) assumed at ${formatMeasurement(200)}.`,
  `Gap between monitors: ${formatMeasurement(gapMm)}.`,
];
const result = evaluateFit([check], assumptions);
const rows = toDimensionDisplayRows([check], result);

const diagramId = 'desk-two-27in-diagram';
const diagramMarkup = renderWorkspaceDiagramMarkup({
  diagramId,
  viewportWidthPx: 640,
  viewportHeightPx: 360,
  paddingPx: 60,
  deskWidthMm,
  deskDepthMm: 700,
  monitorWidthMm,
  monitorDepthMm: 200,
  monitorCount: 2,
  gapMm,
  sideMarginMm,
});

const h1 = 'Desk size for two 27-inch monitors';
const breadcrumb = buildBreadcrumb('/workspace/desk-size-for-two-27-inch-monitors/', 'workspace');
---

<BaseLayout
  title={`${h1} — Fitwise.stream`}
  description="See the minimum and recommended desk width for two 27-inch monitors side by side, with a scale diagram."
  noindex
>
  <div class="wrapper">
    <FitAnswerTemplate
      breadcrumb={breadcrumb}
      h1={h1}
      intro="Two 27-inch monitors side by side need about this much desk width, including a comfortable gap and side clearance."
      state={result.state}
      rows={rows}
      diagramId={diagramId}
      diagramWidthPx={640}
      diagramHeightPx={360}
      diagramSummary={`Two 27-inch monitors on a ${formatMeasurement(deskWidthMm)} desk, ${formatMeasurement(gapMm)} gap, ${formatMeasurement(sideMarginMm)} recommended side clearance.`}
      diagramMarkup={diagramMarkup}
      tableCaption="Desk width breakdown: required, recommended, available and margin"
      assumptions={result.assumptions}
    />
  </div>
</BaseLayout>
