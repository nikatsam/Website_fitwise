---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EntityTemplate from '../../../components/content/templates/EntityTemplate.astro';
import { buildBreadcrumb } from '../../../lib/content';
import { deriveScreenDimensions } from '../../../lib/geometry';
import { pathForLocale } from '../../../i18n/locale';
import { translateRequired } from '../../../i18n/text';

const locale = 'es';
const derived = deriveScreenDimensions(27, { width: 16, height: 9 });
const h1 = 'Dimensiones de un monitor de 27 pulgadas';
const breadcrumb = buildBreadcrumb('/workspace/27-inch-monitor-dimensions/', 'workspace').map(
  (item) => ({
    ...item,
    label:
      item.label === 'Home'
        ? 'Inicio'
        : item.label === 'Workspace'
          ? 'Espacio de trabajo'
          : item.label,
    href: pathForLocale(item.href, locale),
  }),
);
---

<BaseLayout
  title={`${h1} — Fitwise.stream`}
  description="Ancho y alto de la pantalla de un monitor 16:9 de 27 pulgadas, calculados a partir de su diagonal."
  noindex
  language="es"
>
  <div class="wrapper">
    <EntityTemplate
      breadcrumb={breadcrumb}
      h1={h1}
      intro="Dimensiones de la pantalla de un monitor de 27 pulgadas, calculadas a partir de la diagonal y la relación de aspecto 16:9. Solo corresponde a la pantalla: el dispositivo completo es más ancho por el bisel y más profundo si se incluye el soporte."
      measurements={[
        {
          label: translateRequired(locale, 'Screen width'),
          valueMm: derived.screenWidthMm.valueMm,
          note: translateRequired(locale, 'derived from diagonal, screen only'),
        },
        {
          label: translateRequired(locale, 'Screen height'),
          valueMm: derived.screenHeightMm.valueMm,
          note: translateRequired(locale, 'derived from diagonal, screen only'),
        },
      ]}
    />
  </div>
</BaseLayout>

<style>
  .wrapper {
    width: min(100%, var(--content-max-width));
    margin-inline: auto;
    padding-inline: var(--space-5);
  }
  @media (max-width: 40rem) {
    .wrapper {
      padding-inline: var(--space-4);
    }
  }
</style>
