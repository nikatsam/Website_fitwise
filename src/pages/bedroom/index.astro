---
import PublishedLayout from '../../components/layout/PublishedLayout.astro';
import CalculatorPageShell from '../../components/layout/CalculatorPageShell.astro';
import BeforeYouStart from '../../components/fit/BeforeYouStart.astro';
import BedroomFitCheck from '../../components/fitcheck/BedroomFitCheck.astro';
import { CORE_CALCULATOR_START_GUIDANCE } from '../../lib/fit/start-guidance';
---

<PublishedLayout pageIntentId="pi-feature-bedroom">
  <CalculatorPageShell h1="Will your bed fit your room?">
    <p slot="purpose">
      Enter your measured room and mattress dimensions to see whether the layout fits, is tight, or
      does not fit. Custom dimensions are the default; sourced market-specific sizes and named frame
      examples are optional references.
    </p>
    <BeforeYouStart
      slot="before-start"
      id="bedroom-before-start"
      items={CORE_CALCULATOR_START_GUIDANCE.bedroom}
    />
    <BedroomFitCheck slot="calculator" />
    <nav slot="related" class="reference-links" aria-label="Bedroom measurement references">
      <h2>Market-specific references</h2>
      <ul>
        <li>
          <a href="/bedroom/us-bed-size-dimensions/">US bed size dimensions</a>
        </li>
        <li>
          <a href="/bedroom/uk-bed-size-dimensions/">UK bed size dimensions</a>
        </li>
      </ul>
    </nav>
  </CalculatorPageShell>
</PublishedLayout>

<style>
  .reference-links {
    max-width: 82ch;
  }
</style>
