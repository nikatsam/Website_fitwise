---
import PublishedLayout from '../components/layout/PublishedLayout.astro';
import CalculatorPageShell from '../components/layout/CalculatorPageShell.astro';
import BeforeYouStart from '../components/fit/BeforeYouStart.astro';
import UniversalFitCheck from '../components/fitcheck/UniversalFitCheck.astro';
import { CORE_CALCULATOR_START_GUIDANCE } from '../lib/fit/start-guidance';
---

<PublishedLayout pageIntentId="pi-feature-will-it-fit">
  <CalculatorPageShell h1="Will it fit?" eyebrow="Universal fit review">
    <p slot="purpose">
      Check furniture, appliances, boxes or equipment against a destination space and delivery
      route. Use the item's real outside dimensions and enter units you already use.
    </p>
    <BeforeYouStart
      slot="before-start"
      id="universal-before-start"
      items={CORE_CALCULATOR_START_GUIDANCE.universal}
    />
    <UniversalFitCheck slot="calculator" />
    <p slot="support" class="fit-note">
      This is a dimensional screening tool, not a delivery guarantee, building-code check,
      accessibility assessment or ergonomic recommendation. Measure the narrowest clear openings and
      account for packaging, handles, hinges, thresholds, turns and temporary obstacles yourself.
    </p>
  </CalculatorPageShell>
</PublishedLayout>

<style>
  .fit-note {
    max-width: 72ch;
    color: var(--color-text-secondary);
    line-height: 1.65;
  }

  .fit-note {
    font-size: var(--fs-sm);
  }
</style>
