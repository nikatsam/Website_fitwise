---
import PublishedLayout from '../../components/layout/PublishedLayout.astro';
import CalculatorPageShell from '../../components/layout/CalculatorPageShell.astro';
import BeforeYouStart from '../../components/fit/BeforeYouStart.astro';
import DiningFitCheck from '../../components/fitcheck/DiningFitCheck.astro';
import { CORE_CALCULATOR_START_GUIDANCE } from '../../lib/fit/start-guidance';
---

<PublishedLayout pageIntentId="pi-feature-dining">
  <CalculatorPageShell h1="Will the dining table and chairs fit?" eyebrow="Dining room fit">
    <p slot="purpose">
      Compare a measured rectangular table and chair layout with your room. The planner separates
      the physical table-and-chair envelope from any extra walking space you choose.
    </p>
    <BeforeYouStart
      slot="before-start"
      id="dining-before-start"
      items={CORE_CALCULATOR_START_GUIDANCE.dining}
    />
    <DiningFitCheck slot="calculator" />
    <p slot="support" class="fit-note">
      This first version models rectangular tables and identical chair envelopes only. It does not
      model round/oval tables, table bases, chair rotation, people passing, doors, sideboards,
      obstacles, accessibility or serving space. The extra circulation target is user-selected, not
      a sourced minimum or building-code requirement. Replace every example value with measurements
      from your room and furniture.
    </p>
    <p slot="support" class="method-link">
      <a href="/methodology/">How fit states and assumptions work</a>
    </p>
    <p slot="related">
      <a href="/garden/patio-dining-fit/">
        Check this table and chair envelope against gazebo post spans
      </a>
    </p>
  </CalculatorPageShell>
</PublishedLayout>

<style>
  .fit-note {
    max-width: 78ch;
    color: var(--color-text-secondary);
    line-height: 1.65;
  }

  .fit-note {
    font-size: var(--fs-sm);
  }

  .method-link {
    font-size: var(--fs-sm);
  }
</style>
