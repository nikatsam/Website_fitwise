---
import PublishedLayout from '../../components/layout/PublishedLayout.astro';
import CalculatorPageShell from '../../components/layout/CalculatorPageShell.astro';
import FitServicesStudio from '../../components/fitcheck/FitServicesStudio.astro';
import { ALL_FIT_CHECKS_LINK } from '../../data/navigation';
---

<PublishedLayout pageIntentId="pi-feature-fit-services-hub">
  <CalculatorPageShell h1="Advanced all-in-one fit checker" eyebrow="Power-user tool">
    <p slot="purpose">
      Compare a custom item, space, route or equipment mode in one advanced calculator. Each mode
      preserves its own measurements and verification requirements. For a focused standalone check,
      start in the directory.
    </p>
    <p slot="directory" class="advanced-fit-checker__directory-link">
      <a href={ALL_FIT_CHECKS_LINK.href}>Browse focused fit checks</a>
    </p>
    <div slot="calculator" id="fit-services-tool">
      <FitServicesStudio />
    </div>
    <p slot="support" class="advanced-fit-checker__scope">
      Values are editable examples, not product defaults. Use exact dimensions from the items you
      own and current manufacturer manuals for installation, mounting and safety requirements.
      Results are screening calculations, not guarantees or professional assessments.
    </p>
    <p slot="support" class="advanced-fit-checker__method">
      <a href="/methodology/">How fit states and assumptions work</a>
    </p>
  </CalculatorPageShell>
</PublishedLayout>

<style>
  .advanced-fit-checker__directory-link,
  .advanced-fit-checker__scope,
  .advanced-fit-checker__method {
    max-width: 78ch;
  }

  .advanced-fit-checker__directory-link a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 700;
  }

  .advanced-fit-checker__scope,
  .advanced-fit-checker__method {
    color: var(--color-text-secondary);
    font-size: var(--fs-sm);
    line-height: 1.6;
  }
</style>
